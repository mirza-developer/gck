@page "/login"
@using Gck.Resources

<section class="section login-section">
    <div class="container">
        <div class="login-container fade-in-up">
            <div class="login-card gaming-card">
                <div class="login-header">
                    <div class="login-icon">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <h2 class="login-title">
                        ورود به سیستم
                    </h2>
                    <p class="login-subtitle">
                        گیم سنتر کوثر
                    </p>
                </div>

                <!-- Tabs for Admin/Customer selection -->
                <div class="login-tabs">
                    <button class="tab-button @(isAdminTab ? "active" : "")" @onclick="() => SwitchTab(true)">
                        <i class="fas fa-user-shield"></i>
                        @PersianResources.AdminLogin
                    </button>
                    <button class="tab-button @(!isAdminTab ? "active" : "")" @onclick="() => SwitchTab(false)">
                        <i class="fas fa-user"></i>
                        @PersianResources.CustomerLogin
                    </button>
                </div>

                @if (isAdminTab)
                {
                    <!-- Admin Login Form -->
                    <EditForm Model="@loginCommand" OnValidSubmit="HandleAdminLogin">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-user"></i>
                                نام کاربری
                            </label>
                            <InputText @bind-Value="loginCommand.Username"
                                       class="form-input"
                                       placeholder="نام کاربری خود را وارد کنید"
                                       autofocus />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-lock"></i>
                                رمز عبور
                            </label>
                            <InputText type="password"
                                       @bind-Value="loginCommand.Password"
                                       class="form-input"
                                       placeholder="رمز عبور خود را وارد کنید" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-gaming btn-login" disabled="@isLoggingIn">
                                @if (isLoggingIn)
                                {
                                    <i class="fas fa-spinner fa-spin"></i>
                                    <span>در حال ورود...</span>
                                }
                                else
                                {
                                    <i class="fas fa-sign-in-alt"></i>
                                    <span>ورود</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <!-- Customer Login Form -->
                    @if (!otpSent)
                    {
                        <EditForm Model="@sendOtpCommand" OnValidSubmit="HandleSendOtp">
                            <DataAnnotationsValidator />

                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-phone"></i>
                                    @PersianResources.PhoneNumber
                                </label>
                                <InputText @bind-Value="sendOtpCommand.PhoneNumber"
                                           class="form-input"
                                           placeholder="@PersianResources.EnterPhoneNumber"
                                           autofocus />
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn-gaming btn-login" disabled="@isSendingOtp">
                                    @if (isSendingOtp)
                                    {
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <span>@PersianResources.SendingOtp</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-paper-plane"></i>
                                        <span>@PersianResources.SendOtp</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="@verifyOtpCommand" OnValidSubmit="HandleVerifyOtp">
                            <DataAnnotationsValidator />

                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-phone"></i>
                                    @PersianResources.PhoneNumber
                                </label>
                                <input type="text"
                                       class="form-input"
                                       value="@verifyOtpCommand.PhoneNumber"
                                       disabled />
                            </div>

                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-key"></i>
                                    @PersianResources.OtpCode
                                </label>
                                <InputText @bind-Value="verifyOtpCommand.OtpCode"
                                           class="form-input"
                                           placeholder="@PersianResources.EnterOtpCode"
                                           maxlength="6"
                                           autofocus />
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn-gaming btn-login" disabled="@isVerifyingOtp">
                                    @if (isVerifyingOtp)
                                    {
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <span>@PersianResources.VerifyingOtp</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check"></i>
                                        <span>@PersianResources.VerifyOtp</span>
                                    }
                                </button>
                            </div>

                            <div class="form-actions" style="margin-top: 1rem;">
                                <button type="button" class="btn-gaming btn-secondary" @onclick="HandleResendOtp" disabled="@(!canResendOtp || isSendingOtp)" style="width: 100%;">
                                    @if (isSendingOtp)
                                    {
                                        <i class="fas fa-spinner fa-spin"></i>
                                        <span>@PersianResources.SendingOtp</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-redo"></i>
                                        <span>
                                            @if (resendCountdown > 0)
                                            {
                                                @($"{PersianResources.ResendOtp} ({resendCountdown} ثانیه)")
                                            }
                                            else
                                            {
                                                @PersianResources.ResendOtp
                                            }
                                        </span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                }
            </div>
        </div>
    </div>
</section>
