@page "/management"
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>مدیریت گیم سنتر</PageTitle>

<div class="container" style="padding: 2rem; direction: rtl;">
    <h1 class="text-center mb-4">پنل مدیریت گیم سنتر کوثر</h1>

    @if (loading)
    {
        <div class="text-center">
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="alert alert-warning text-center">
            <h4>⚠️ توجه</h4>
            <p>برای استفاده از پنل مدیریت، ابتدا باید سرور API را اجرا کنید.</p>
            <p><strong>خطا:</strong> @error</p>
            <hr />
            <p><small>برای اجرای API، دستور زیر را در ترمینال اجرا کنید:</small></p>
            <code style="display: block; background: #f5f5f5; padding: 10px; border-radius: 5px; direction: ltr;">
                cd Gck.Api && dotnet run
            </code>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">میزها</h5>
                        <h2 class="text-primary">@tables.Count</h2>
                        <button class="btn btn-primary btn-sm" @onclick="@(() => ShowSection("tables"))">مدیریت</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">مشتریان</h5>
                        <h2 class="text-success">@customers.Count</h2>
                        <button class="btn btn-success btn-sm" @onclick="@(() => ShowSection("customers"))">مدیریت</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">حساب‌های مالی</h5>
                        <h2 class="text-info">@financialAccounts.Count</h2>
                        <button class="btn btn-info btn-sm" @onclick="@(() => ShowSection("accounts"))">مدیریت</button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title">میزهای اشغال</h5>
                        <h2 class="text-warning">@occupiedTablesCount</h2>
                        <button class="btn btn-warning btn-sm" @onclick="@(() => ShowSection("dashboard"))">داشبورد</button>
                    </div>
                </div>
            </div>
        </div>

        @if (activeSection == "tables")
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>مدیریت میزها</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>نام میز</th>
                                <th>تعداد دسته</th>
                                <th>هزینه هر ساعت (تومان)</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in tables)
                            {
                                <tr>
                                    <td>@table.Name</td>
                                    <td>@table.NumberOfControllers</td>
                                    <td>@table.HourlyFeePerController.ToString("N0")</td>
                                    <td>
                                        <span class="badge @(table.IsOccupied ? "bg-danger" : "bg-success")">
                                            @(table.IsOccupied ? "اشغال" : "آزاد")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeSection == "customers")
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>مدیریت مشتریان</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>نام</th>
                                <th>شماره تماس</th>
                                <th>سال تولد</th>
                                <th>جنسیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in customers)
                            {
                                <tr>
                                    <td>@customer.Name</td>
                                    <td>@customer.PhoneNumber</td>
                                    <td>@customer.BirthYear</td>
                                    <td>@customer.Gender</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeSection == "accounts")
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h3>حساب‌های مالی</h3>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>نام حساب</th>
                                <th>شماره کارت</th>
                                <th>نام بانک</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in financialAccounts)
                            {
                                <tr>
                                    <td>@account.AccountName</td>
                                    <td>@account.CardNumber</td>
                                    <td>@account.BankName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (activeSection == "dashboard")
        {
            <div class="card">
                <div class="card-header">
                    <h3>داشبورد میزها</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <p><strong>توجه:</strong> برای مشاهده داشبورد کامل با امکانات شروع و پایان جلسات، باید API را اجرا کنید و از آن استفاده کنید.</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<TableDto> tables = new();
    private List<CustomerDto> customers = new();
    private List<FinancialAccountDto> financialAccounts = new();
    private bool loading = true;
    private string? error = null;
    private string activeSection = "tables";
    private int occupiedTablesCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            error = null;

            // Try to load tables from API
            var tablesResponse = await Http.GetAsync("http://localhost:5001/api/tables");
            if (tablesResponse.IsSuccessStatusCode)
            {
                tables = await tablesResponse.Content.ReadFromJsonAsync<List<TableDto>>() ?? new();
                occupiedTablesCount = tables.Count(t => t.IsOccupied);
            }

            // Try to load customers
            var customersResponse = await Http.GetAsync("http://localhost:5001/api/customers");
            if (customersResponse.IsSuccessStatusCode)
            {
                customers = await customersResponse.Content.ReadFromJsonAsync<List<CustomerDto>>() ?? new();
            }

            // Try to load financial accounts
            var accountsResponse = await Http.GetAsync("http://localhost:5001/api/financialaccounts");
            if (accountsResponse.IsSuccessStatusCode)
            {
                financialAccounts = await accountsResponse.Content.ReadFromJsonAsync<List<FinancialAccountDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            loading = false;
        }
    }

    private void ShowSection(string section)
    {
        activeSection = section;
    }

    // DTOs
    public class TableDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int NumberOfControllers { get; set; }
        public decimal HourlyFeePerController { get; set; }
        public bool IsOccupied { get; set; }
    }

    public class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public int BirthYear { get; set; }
        public string Gender { get; set; } = string.Empty;
    }

    public class FinancialAccountDto
    {
        public int Id { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public string CardNumber { get; set; } = string.Empty;
        public string BankName { get; set; } = string.Empty;
    }
}
