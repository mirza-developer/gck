<div class="pdp-container">
    <div class="pdp-input" @onclick="TogglePicker">
        <i class="fas fa-calendar-alt"></i>
        <span>@GetDisplayText()</span>
    </div>
    
    @if (isOpen)
    {
        <div class="pdp-overlay" @onclick="TogglePicker"></div>
        <div class="pdp-popup">
            <div class="pdp-header">
                <button type="button" class="pdp-nav-btn" @onclick="PreviousMonth">
                    <i class="fas fa-chevron-right"></i>
                </button>
                <div class="pdp-month-title">@CurrentMonthName @CurrentYear</div>
                <button type="button" class="pdp-nav-btn" @onclick="NextMonth">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </div>
            
            <div class="pdp-calendar">
                <div class="pdp-weekdays">
                    @foreach (var day in weekDays)
                    {
                        <div class="pdp-weekday">@day</div>
                    }
                </div>
                
                <div class="pdp-days">
                    @foreach (var day in GetCalendarDays())
                    {
                        var cssClass = "pdp-day";
                        if (day.IsCurrentMonth) cssClass += " pdp-day-current";
                        if (!day.IsCurrentMonth) cssClass += " pdp-day-other";
                        if (day.IsToday) cssClass += " pdp-day-today";
                        if (day.IsSelected) cssClass += " pdp-day-selected";
                        
                        <button type="button" 
                                class="@cssClass"
                                @onclick="() => SelectDate(day)"
                                disabled="@(!day.IsCurrentMonth)">
                            <span class="pdp-day-number">@day.Day</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>
