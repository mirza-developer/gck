@page "/creditwithdrawals"
@using Gck.Resources
@using Gck.Components
@using Gck.Application.DTOs

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-money-bill-wave"></i>
                @PersianResources.CreditWithdrawals
            </h2>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else
        {
            <!-- Filter Tabs -->
            <div class="gaming-card fade-in-up" style="margin-bottom: 1rem;">
                <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                    <!-- Filter Tabs -->
                    <button class="btn-gaming @(statusFilter == null ? "" : "btn-secondary")" @onclick="FilterAll">
                        همه
                    </button>
                    <button class="btn-gaming @(statusFilter == "Pending" ? "" : "btn-secondary")" @onclick="FilterPending">
                        <i class="fas fa-clock"></i>
                        @PersianResources.WithdrawalPending
                    </button>
                    <button class="btn-gaming @(statusFilter == "Approved" ? "" : "btn-secondary")" @onclick="FilterApproved">
                        <i class="fas fa-check"></i>
                        @PersianResources.WithdrawalApproved
                    </button>
                    <button class="btn-gaming @(statusFilter == "Rejected" ? "" : "btn-secondary")" @onclick="FilterRejected">
                        <i class="fas fa-times"></i>
                        @PersianResources.WithdrawalRejected
                    </button>
                </div>
            </div>

            <div class="gaming-card fade-in-up">
                @if (requests.Any())
                {
                    <div class="data-grid">
                        <table class="data-grid-table">
                            <thead class="data-grid-header">
                                <tr>
                                    <th>@PersianResources.CustomerName</th>
                                    <th>@PersianResources.Phone</th>
                                    <th>@PersianResources.WithdrawalAmount</th>
                                    <th>@PersianResources.WithdrawalRequestDate</th>
                                    <th>وضعیت</th>
                                    <th>@PersianResources.WithdrawalNotes</th>
                                    <th>@PersianResources.Actions</th>
                                </tr>
                            </thead>
                            <tbody class="data-grid-body">
                                @foreach (var req in requests)
                                {
                                    <tr>
                                        <td><span class="grid-cell-primary">@req.CustomerName</span></td>
                                        <td><span class="grid-cell-secondary">@req.CustomerPhone</span></td>
                                        <td>
                                            <span class="grid-cell-badge" style="background: rgba(0,200,100,0.2); color: #00cc66;">
                                                <i class="fas fa-coins"></i>
                                                @req.Amount.ToString("N0") @PersianResources.Toman
                                            </span>
                                        </td>
                                        <td><span class="grid-cell-secondary">@req.RequestDate.ToString("yyyy/MM/dd HH:mm")</span></td>
                                        <td>@GetStatusBadge(req.Status)</td>
                                        <td><span class="grid-cell-secondary">@(string.IsNullOrEmpty(req.Notes) ? "-" : req.Notes)</span></td>
                                        <td>
                                            @if (req.Status == "Pending")
                                            {
                                                <div class="grid-actions">
                                                    <button class="grid-action-btn edit" @onclick="() => ApproveRequest(req.Id)">
                                                        <i class="fas fa-check"></i>
                                                        @PersianResources.ApproveWithdrawal
                                                    </button>
                                                    <button class="grid-action-btn delete" @onclick="() => RejectRequest(req.Id)">
                                                        <i class="fas fa-times"></i>
                                                        @PersianResources.RejectWithdrawal
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="grid-cell-secondary">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>@PersianResources.NoWithdrawalsFound</p>
                    </div>
                }
            </div>
        }
    </div>
</section>
