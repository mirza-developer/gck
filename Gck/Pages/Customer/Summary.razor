@page "/customer/summary"
@using Gck.Resources
@using Gck.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ApiConfigurationService ApiConfig
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<section class="section">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-user-circle"></i>
                @PersianResources.MySummary
            </h1>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @errorMessage
            </div>
        }
        else if (customer != null)
        {
            <div class="gaming-card fade-in-up">
                <!-- Customer Info Section -->
                <div class="grid-details-content" style="margin-bottom: 2rem;">
                    <div class="grid-details-header">
                        <i class="fas fa-user"></i>
                        <h4>@PersianResources.CustomerFullDetails</h4>
                    </div>
                    <div class="grid-details-body">
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-user"></i>
                                @PersianResources.CustomerName
                            </div>
                            <div class="grid-detail-value">
                                @customer.Name
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-phone"></i>
                                @PersianResources.Phone
                            </div>
                            <div class="grid-detail-value">
                                @customer.PhoneNumber
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-calendar-alt"></i>
                                @PersianResources.BirthYear
                            </div>
                            <div class="grid-detail-value">
                                @customer.BirthYear @PersianResources.Shamsi
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas @(customer.IsMale ? "fa-mars" : "fa-venus")"></i>
                                @PersianResources.Gender
                            </div>
                            <div class="grid-detail-value">
                                @(customer.IsMale ? PersianResources.Male : PersianResources.Female)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loyalty Info Section -->
                @if (customer.IsLoyal)
                {
                    <div class="grid-details-content" style="margin-bottom: 2rem;">
                        <div class="grid-details-header">
                            <i class="fas fa-star"></i>
                            <h4>@PersianResources.LoyaltyInfo</h4>
                        </div>
                        <div class="grid-details-body">
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-coins"></i>
                                    @PersianResources.TotalPaidSessions
                                </div>
                                <div class="grid-detail-value highlight">
                                    @customer.PaidSessionsCount @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-gift"></i>
                                    @PersianResources.SessionsRequiredForFree
                                </div>
                                <div class="grid-detail-value">
                                    @customer.SessionsRequiredForFree @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-trophy"></i>
                                    @PersianResources.FreeSessionsEarned
                                </div>
                                <div class="grid-detail-value highlight">
                                    @(customer.PaidSessionsCount / customer.SessionsRequiredForFree) @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-hourglass-half"></i>
                                    @PersianResources.SessionsUntilFree
                                </div>
                                <div class="grid-detail-value highlight">
                                    @(customer.SessionsRequiredForFree - (customer.PaidSessionsCount % customer.SessionsRequiredForFree)) @PersianResources.Times
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Sessions List -->
                <div class="grid-details-header">
                    <i class="fas fa-gamepad"></i>
                    <h4>@PersianResources.MySessions</h4>
                </div>
                @if (sessions != null && sessions.Any())
                {
                    <div class="data-grid">
                        <table class="data-grid-table">
                            <thead class="data-grid-header">
                                <tr>
                                    <th>@PersianResources.SessionDate</th>
                                    <th>@PersianResources.TableUsed</th>
                                    <th>@PersianResources.Duration</th>
                                    <th>@PersianResources.AmountPaid</th>
                                </tr>
                            </thead>
                            <tbody class="data-grid-body">
                                @foreach (var session in sessions)
                                {
                                    <tr>
                                        <td>
                                            <span class="grid-cell-primary">@session.StartDateTime.ToString("yyyy/MM/dd HH:mm")</span>
                                        </td>
                                        <td>
                                            <span class="grid-cell-secondary">@session.TableName</span>
                                        </td>
                                        <td>
                                            <span class="grid-cell-secondary">@GetDuration(session)</span>
                                        </td>
                                        <td>
                                            @if (session.IsFreeSession)
                                            {
                                                <span class="grid-cell-badge" style="background: rgba(0, 255, 0, 0.2); color: #00ff00; border: 1px solid rgba(0, 255, 0, 0.3);">
                                                    <i class="fas fa-gift"></i>
                                                    @PersianResources.Free
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="grid-cell-primary">@session.FinalPrice?.ToString("N0") @PersianResources.Toman</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>@PersianResources.NoSessionsYet</p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private CustomerSummaryDto? customer;
    private List<CustomerSessionDto> sessions = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerSummary();
    }

    private async Task LoadCustomerSummary()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            // Get customer ID from local storage
            var customerIdStr = await LocalStorage.GetItemAsync<string>("currentUserId");
            var userRole = await LocalStorage.GetItemAsync<string>("userRole");

            if (string.IsNullOrEmpty(customerIdStr) || userRole != "customer")
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Load customer details
            var customerResponse = await Http.GetAsync(ApiConfig.GetApiUrl($"/api/customers/{customerIdStr}"));
            if (customerResponse.IsSuccessStatusCode)
            {
                customer = await customerResponse.Content.ReadFromJsonAsync<CustomerSummaryDto>();
            }

            // Load customer sessions
            var sessionsResponse = await Http.GetAsync(ApiConfig.GetApiUrl($"/api/customers/{customerIdStr}/sessions"));
            if (sessionsResponse.IsSuccessStatusCode)
            {
                sessions = await sessionsResponse.Content.ReadFromJsonAsync<List<CustomerSessionDto>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.LoadingError}: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDuration(CustomerSessionDto session)
    {
        if (!session.EndDateTime.HasValue)
            return "-";

        var duration = session.EndDateTime.Value - session.StartDateTime;
        var hours = (int)duration.TotalHours;
        var minutes = duration.Minutes;

        if (hours > 0 && minutes > 0)
            return $"{hours} {PersianResources.Hours} {PersianResources.And} {minutes} {PersianResources.Minutes}";
        else if (hours > 0)
            return $"{hours} {PersianResources.Hours}";
        else
            return $"{minutes} {PersianResources.Minutes}";
    }

    public class CustomerSummaryDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public int BirthYear { get; set; }
        public bool IsMale { get; set; }
        public bool IsLoyal { get; set; }
        public int SessionsRequiredForFree { get; set; }
        public int PaidSessionsCount { get; set; }
    }

    public class CustomerSessionDto
    {
        public int Id { get; set; }
        public DateTime StartDateTime { get; set; }
        public DateTime? EndDateTime { get; set; }
        public string TableName { get; set; } = string.Empty;
        public bool IsFreeSession { get; set; }
        public decimal? FinalPrice { get; set; }
    }
}
