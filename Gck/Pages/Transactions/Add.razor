@page "/transactions/add"
@using Gck.Application.DTOs
@using Gck.Resources
@using System.Net.Http.Json
@using Gck.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ApiConfigurationService ApiConfig

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-plus-circle"></i>
                @PersianResources.AddNewTransaction
            </h2>
            <button class="btn-secondary" @onclick="GoBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="gaming-loader">
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <p class="loader-text">@PersianResources.Loading</p>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @errorMessage
            </div>
        }
        else
        {
            <div class="gaming-card form-card fade-in-up">
                <form @onsubmit="HandleSubmit">
                    <div class="form-group">
                        <label for="accountId">
                            @PersianResources.FinancialAccount
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <select id="accountId" 
                                @bind="transaction.FinancialAccountId" 
                                class="form-control"
                                required>
                            <option value="0">@PersianResources.SelectFinancialAccount</option>
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">
                                    @account.AccountName (@account.BankName)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="type">
                            @PersianResources.TransactionType
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <select id="type" 
                                @bind="transaction.Type" 
                                class="form-control"
                                required>
                            <option value="">@PersianResources.SelectTransactionType</option>
                            <option value="Income">@PersianResources.Income</option>
                            <option value="Outcome">@PersianResources.Outcome</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="amount">
                            @PersianResources.Amount (@PersianResources.Toman)
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <input type="number" 
                               id="amount" 
                               @bind="transaction.Amount" 
                               class="form-control"
                               placeholder="@PersianResources.AmountPlaceholder"
                               min="0"
                               step="1000"
                               required />
                    </div>

                    <div class="form-group">
                        <label for="date">
                            @PersianResources.TransactionDate
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <PersianDatePicker @bind-Value="transaction.TransactionDate" />
                    </div>

                    <div class="form-group">
                        <label for="description">
                            @PersianResources.Description
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <textarea id="description" 
                                  @bind="transaction.Description" 
                                  class="form-control"
                                  placeholder="@PersianResources.DescriptionPlaceholder"
                                  rows="4"
                                  maxlength="500"
                                  required></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-gaming" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>@PersianResources.Saving</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>@PersianResources.SubmitTransaction</span>
                            }
                        </button>
                        <button type="button" class="btn-secondary" @onclick="GoBack">
                            <i class="fas fa-times"></i>
                            @PersianResources.Cancel
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</section>

@code {
    private CreateTransactionDto transaction = new() 
    { 
        TransactionDate = DateTime.Now 
    };
    private List<FinancialAccountDto> accounts = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadFinancialAccounts();
    }

    private async Task LoadFinancialAccounts()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            accounts = await Http.GetFromJsonAsync<List<FinancialAccountDto>>(ApiConfig.GetApiUrl("/api/financialaccounts")) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = PersianResources.LoadFinancialAccountsError;
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (transaction.FinancialAccountId == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", PersianResources.PleaseSelectFinancialAccount);
            return;
        }

        if (string.IsNullOrEmpty(transaction.Type))
        {
            await JSRuntime.InvokeVoidAsync("alert", PersianResources.PleaseSelectTransactionType);
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/transactions"), transaction);

            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("alert", PersianResources.TransactionAddSuccess);
                Navigation.NavigateTo("/transactions");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"{PersianResources.ErrorSavingTransaction}: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = PersianResources.ApiConnectionError;
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/transactions");
    }
}
