@page "/management"
@inject HttpClient Http
@inject ApiConfigurationService ApiConfig
@using System.Net.Http.Json

<PageTitle>داشبورد مدیریت</PageTitle>

<div class="container" style="padding: 2rem; direction: rtl;">
    <h1 class="text-center mb-4">داشبورد مدیریت گیم سنتر کوثر</h1>

    @if (loading)
    {
        <div class="text-center">
            <p>در حال بارگذاری...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="alert alert-warning text-center">
            <h4>⚠️ توجه</h4>
            <p>برای استفاده از داشبورد، ابتدا باید سرور API را اجرا کنید.</p>
            <p><strong>خطا:</strong> @error</p>
            <hr />
            <p><small>برای اجرای API، دستور زیر را در ترمینال اجرا کنید:</small></p>
            <code style="display: block; background: #f5f5f5; padding: 10px; border-radius: 5px; direction: ltr;">
                cd Gck.Api && dotnet run
            </code>
        </div>
    }
    else
    {
        <!-- Tables Status Section -->
        <div class="card mb-4">
            <div class="card-header">
                <h3>وضعیت میزها</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var table in dashboardTables)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card @(table.IsOccupied ? "border-danger" : "border-success")">
                                <div class="card-body">
                                    <h5 class="card-title">@table.Name</h5>
                                    <p class="card-text">
                                        <strong>وضعیت:</strong> 
                                        <span class="badge @(table.IsOccupied ? "bg-danger" : "bg-success")">
                                            @(table.IsOccupied ? "اشغال" : "آزاد")
                                        </span>
                                    </p>
                                    @if (table.CurrentSession != null)
                                    {
                                        <hr />
                                        <p class="mb-1"><strong>جلسه فعال:</strong></p>
                                        <p class="mb-1"><small>شروع: @table.CurrentSession.StartDateTime.ToString("HH:mm - yyyy/MM/dd")</small></p>
                                        <p class="mb-1"><small>نرخ ساعتی: @table.CurrentSession.FeePerHour.ToString("N0") تومان</small></p>
                                        @if (table.CurrentSession.Customers.Any())
                                        {
                                            <p class="mb-0"><small>مشتریان: @string.Join(", ", table.CurrentSession.Customers.Select(c => c.Name))</small></p>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Analytics Charts Section -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h4>مقایسه روزانه (این هفته)</h4>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <p><strong>نمودار در حال توسعه:</strong> مجموع رسیدهای روزانه برای امروز در مقایسه با سایر روزهای این هفته (تقویم شمسی)</p>
                        </div>
                        <!-- Chart placeholder - will be implemented with chart library -->
                        <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border-radius: 8px;">
                            <p class="text-muted">نمودار مقایسه روزانه</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h4>مقایسه ماهانه (امسال)</h4>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <p><strong>نمودار در حال توسعه:</strong> مجموع رسیدهای ماهانه برای این ماه در مقایسه با سایر ماه‌های امسال (تقویم شمسی)</p>
                        </div>
                        <!-- Chart placeholder - will be implemented with chart library -->
                        <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #f8f9fa; border-radius: 8px;">
                            <p class="text-muted">نمودار مقایسه ماهانه</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<DashboardTableDto> dashboardTables = new();
    private bool loading = true;
    private string? error = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            error = null;

            // Load dashboard tables with active sessions
            var response = await Http.GetAsync(ApiConfig.GetApiUrl("/api/dashboard/tables"));
            if (response.IsSuccessStatusCode)
            {
                dashboardTables = await response.Content.ReadFromJsonAsync<List<DashboardTableDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            loading = false;
        }
    }

    // DTOs
    public class DashboardTableDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsOccupied { get; set; }
        public SessionDto? CurrentSession { get; set; }
    }

    public class SessionDto
    {
        public int Id { get; set; }
        public int TableId { get; set; }
        public string TableName { get; set; } = string.Empty;
        public decimal FeePerHour { get; set; }
        public DateTime StartDateTime { get; set; }
        public DateTime? EndDateTime { get; set; }
        public bool IsCompleted { get; set; }
        public decimal? RecommendedPrice { get; set; }
        public decimal? FinalPrice { get; set; }
        public List<CustomerDto> Customers { get; set; } = new();
    }

    public class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public int BirthYear { get; set; }
        public string Gender { get; set; } = string.Empty;
    }
}
