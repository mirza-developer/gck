@using Gck.Application.DTOs
@using Gck.Shared.Modals
@using Gck.Resources

<Modal @bind-IsVisible="isVisible"
       Title="@(showConfirm ? PersianResources.ConfirmFinishSession : PersianResources.FinishSession)"
       ShowFooter="false"
       CloseOnOverlayClick="@(!loading)"
       Size="@(showConfirm ? ModalSize.Medium : ModalSize.Large)">
    @if (loading)
    {
        <LoadingSpinner LoadingText="@PersianResources.Loading" Fullscreen="true" />
    }
    else if (!showConfirm)
    {
        if (sessionDetails != null)
        {
            <div class="session-summary">
                <div class="summary-row">
                    <span class="label"><i class="fas fa-table"></i> @PersianResources.Table:</span>
                    <span class="value">@sessionDetails.TableName</span>
                </div>
                <div class="summary-row">
                    <span class="label"><i class="fas fa-clock"></i> @PersianResources.StartTime:</span>
                    <span class="value">@sessionDetails.StartDateTime.ToPersianDateTime()</span>
                </div>
                <div class="summary-row">
                    <span class="label"><i class="fas fa-clock"></i> @PersianResources.EndTime:</span>
                    <span class="value">@DateTime.Now.ToPersianDateTime()</span>
                </div>
                <div class="summary-row">
                    <span class="label"><i class="fas fa-hourglass-half"></i> @PersianResources.Duration:</span>
                    <span class="value">@GetDuration()</span>
                </div>
                <div class="summary-row">
                    <span class="label"><i class="fas fa-money-bill-wave"></i> @PersianResources.HourlyRate:</span>
                    <span class="value">@sessionDetails.FeePerHour.ToString("N0") @PersianResources.Toman</span>
                </div>
                @if (sessionDetails.Customers.Any() || sessionDetails.AnonymousCustomersCount > 0)
                {
                    <div class="summary-row">
                        <span class="label"><i class="fas fa-users"></i> @PersianResources.Customers:</span>
                        <span class="value">
                            @if (sessionDetails.Customers.Any())
                            {
                                @string.Join("? ", sessionDetails.Customers.Select(c => c.Name))
                                @if (sessionDetails.AnonymousCustomersCount > 0)
                                {
                                    <text> + </text>
                                }
                            }
                            @if (sessionDetails.AnonymousCustomersCount > 0)
                            {
                                <span>@sessionDetails.AnonymousCustomersCount @PersianResources.AnonymousCustomer</span>
                            }
                        </span>
                    </div>
                }

                @* Loyalty Program Display *@
                @if (customersLoyalty.Any(c => c.IsLoyal))
                {
                    <div class="loyalty-section">
                        <div class="loyalty-header">
                            <i class="fas fa-star"></i>
                            <span>@PersianResources.LoyaltyProgram</span>
                        </div>

                        @foreach (var customer in sessionDetails.Customers)
                        {
                            var loyaltyInfo = customersLoyalty.FirstOrDefault(l => l.CustomerId == customer.Id);
                            if (loyaltyInfo != null && loyaltyInfo.IsLoyal)
                            {
                                <div class="customer-loyalty-card">
                                    <div class="customer-info">
                                        <i class="fas fa-user-circle"></i>
                                        <span class="customer-name">@customer.Name</span>
                                        @if (loyaltyInfo.CanGetFreeSession)
                                        {
                                            <span class="free-badge">
                                                <i class="fas fa-gift"></i>
                                                @PersianResources.FreeSessionEarned
                                            </span>
                                        }
                                    </div>

                                    <div class="loyalty-progress-container">
                                        <div class="progress-info">
                                            <span class="sessions-count">
                                                @loyaltyInfo.PaidSessionsCount / @loyaltyInfo.SessionsRequiredForFree
                                                @PersianResources.CompletedSessions
                                            </span>
                                            @if (!loyaltyInfo.CanGetFreeSession && loyaltyInfo.RemainingSessionsForFree > 0)
                                            {
                                                <span class="remaining-sessions">
                                                    @loyaltyInfo.RemainingSessionsForFree @PersianResources.SessionsUntilFree
                                                </span>
                                            }
                                        </div>

                                        <div class="loyalty-progress-bar">
                                            <div class="progress-fill @(loyaltyInfo.CanGetFreeSession ? "completed" : "")"
                                                 style="width: @loyaltyInfo.ProgressPercentage%">
                                            </div>
                                            <div class="progress-circles">
                                                @for (int i = 0; i < loyaltyInfo.SessionsRequiredForFree; i++)
                                                {
                                                    var isCompleted = i < loyaltyInfo.PaidSessionsCount;
                                                    <div class="progress-circle @(isCompleted ? "completed" : "")">
                                                        @if (isCompleted)
                                                        {
                                                            <i class="fas fa-check"></i>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="price-section">
                @if (hasFreeSessionDiscount)
                {
                    <div class="free-session-notice">
                        <i class="fas fa-gift"></i>
                        <span>@PersianResources.FreeSessionDiscount (@freeSessionCustomersCount @(freeSessionCustomersCount > 1 ? PersianResources.Customer : PersianResources.Customer))</span>
                    </div>
                    <div class="recommended-price original-price">
                        <i class="fas fa-tag"></i>
                        <span>@PersianResources.OriginalPrice:</span>
                        <del>@originalRecommendedPrice.ToString("N0") @PersianResources.Toman</del>
                    </div>
                    <div class="recommended-price discount-price">
                        <i class="fas fa-percent"></i>
                        <span>@PersianResources.Discount (@freeSessionCustomersCount/@totalPeopleInSession @PersianResources.Person):</span>
                        <strong class="discount-text">-@totalDiscountAmount.ToString("N0") @PersianResources.Toman</strong>
                    </div>
                    <div class="recommended-price discounted-price">
                        <i class="fas fa-calculator"></i>
                        <span>@PersianResources.RecommendedPrice:</span>
                        <strong class="recommended-text">@recommendedPrice.ToString("N0") @PersianResources.Toman</strong>
                    </div>
                }
                else
                {
                    <div class="recommended-price">
                        <i class="fas fa-calculator"></i>
                        <span>@PersianResources.RecommendedPrice:</span>
                        <strong>@recommendedPrice.ToString("N0") @PersianResources.Toman</strong>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-edit"></i>
                        @PersianResources.EditableFinalPrice
                    </label>
                    <input type="number"
                           class="form-input"
                           @bind="finalPrice"
                           @bind:event="oninput"
                           step="1000"
                           min="0" />
                </div>

                @if (finalPrice != recommendedPrice)
                {
                    <div class="price-difference @(finalPrice > recommendedPrice ? "increase" : "decrease")">
                        <i class="fas @(finalPrice > recommendedPrice ? "fa-arrow-up" : "fa-arrow-down")"></i>
                        <span>@PersianResources.PriceDifference: @Math.Abs(finalPrice - recommendedPrice).ToString("N0") @PersianResources.Toman</span>
                    </div>
                }

                @* Credit Usage Section *@
                @if (sessionCustomerCredits.Any())
                {
                    <div class="loyalty-section" style="margin-top: 1rem;">
                        <div class="loyalty-header">
                            <i class="fas fa-coins"></i>
                            <span>@PersianResources.UseCredit</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-user"></i>
                                @PersianResources.SelectCustomerForCredit
                            </label>
                            <select class="form-input" @onchange="@(e => OnCreditCustomerChanged(int.TryParse(e.Value?.ToString(), out var cid) ? (int?)cid : null))">
                                <option value="">-- بدون اعتبار --</option>
                                @foreach (var c in sessionCustomerCredits)
                                {
                                    <option value="@c.CustomerId">@c.CustomerName - @c.CreditBalance.ToString("N0") @PersianResources.Toman</option>
                                }
                            </select>
                        </div>
                        @if (selectedCreditCustomerId.HasValue && creditCustomerBalance > 0)
                        {
                            <div class="form-group">
                                <label class="form-label">
                                    <i class="fas fa-coins"></i>
                                    @PersianResources.CreditToUse (@PersianResources.AvailableCredit: @creditCustomerBalance.ToString("N0") @PersianResources.Toman)
                                </label>
                                <input type="number"
                                       class="form-input"
                                       min="0"
                                       max="@Math.Min(creditCustomerBalance, finalPrice)"
                                       step="1000"
                                       value="@creditToUse"
                                       @oninput="@(e => OnCreditToUseChanged(decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0))" />
                            </div>
                            @if (creditToUse > 0)
                            {
                                <div class="recommended-price discount-price">
                                    <i class="fas fa-coins"></i>
                                    <span>@PersianResources.CreditUsedInSession:</span>
                                    <strong class="discount-text">-@creditToUse.ToString("N0") @PersianResources.Toman</strong>
                                </div>
                                <div class="recommended-price discounted-price">
                                    <i class="fas fa-calculator"></i>
                                    <span>مبلغ پرداختی نقدی:</span>
                                    <strong class="recommended-text">@((finalPrice - creditToUse).ToString("N0")) @PersianResources.Toman</strong>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-gaming" @onclick="ProceedToConfirm">
                    <i class="fas fa-arrow-left"></i>
                    <span>@PersianResources.Confirm</span>
                </button>
                <button type="button" class="btn-gaming btn-warning" @onclick="ResumeSession">
                    <i class="fas fa-undo"></i>
                    <span>@PersianResources.ResumeSession</span>
                </button>
                <button type="button" class="btn-gaming btn-secondary" @onclick="Close">
                    <i class="fas fa-times"></i>
                    <span>@PersianResources.Cancel</span>
                </button>
            </div>
        }
    }
    else
    {
        <div class="confirm-summary">
            <div class="summary-item">
                <span class="label">@PersianResources.Table:</span>
                <span class="value">@sessionDetails?.TableName</span>
            </div>
            <div class="summary-item">
                <span class="label">@PersianResources.FinalPrice:</span>
                <span class="value highlight">@finalPrice.ToString("N0") @PersianResources.Toman</span>
            </div>
            @if (creditToUse > 0)
            {
                <div class="summary-item">
                    <span class="label">@PersianResources.CreditUsedInSession:</span>
                    <span class="value" style="color: #00cc66;">-@creditToUse.ToString("N0") @PersianResources.Toman</span>
                </div>
                <div class="summary-item">
                    <span class="label">مبلغ پرداختی نقدی:</span>
                    <span class="value highlight">@((finalPrice - creditToUse).ToString("N0")) @PersianResources.Toman</span>
                </div>
            }
        </div>

        <div class="form-group">
            <label class="form-label">
                <i class="fas fa-wallet"></i>
                @PersianResources.FinancialAccount
            </label>
            <MultiSelectDropdown TItem="FinancialAccountDto"
                                 TValue="int"
                                 Items="financialAccounts"
                                 IsMultiSelect="false"
                                 SelectedValue="selectedFinancialAccountId"
                                 SelectedValueChanged="@((int value) => selectedFinancialAccountId = value)"
                                 ValueSelector="@(account => account.Id)"
                                 DisplayTextSelector="@(account => $"{account.AccountName} - {account.BankName}")"
                                 Placeholder="@PersianResources.SelectFinancialAccount"
                                 EnableSearch="true"
                                 SearchPlaceholder="@PersianResources.Search"
                                 NoResultsText="@PersianResources.NoResultsFound" />
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-gaming" @onclick="FinishSession" disabled="@(loading || selectedFinancialAccountId == 0)">
                <i class="fas fa-check"></i>
                <span>@PersianResources.ConfirmAndFinish</span>
            </button>
            <button type="button" class="btn-gaming btn-secondary" @onclick="BackToPrice" disabled="@loading">
                <i class="fas fa-arrow-right"></i>
                <span>@PersianResources.Back</span>
            </button>
        </div>
    }
</Modal>
