<Project>

  <PropertyGroup>
    <!--
      BlazorMode controls the hosting model for the Gck client project.

      Allowed values:
        WebAssembly  (default) – runs entirely in the browser (Blazor WASM).
        Server                 – UI rendered on the server via SignalR (Blazor Server).

      How to change the mode:
        Option 1 – Edit this file: change the value below and save.
        Option 2 – Command line:   dotnet build /p:BlazorMode=Server
                                   dotnet run   /p:BlazorMode=Server

      NOTE: This file is manually imported at the very top of Gck.csproj, before
      any SDK is loaded, so the value is available for conditional SDK selection.
    -->
    <BlazorMode Condition="'$(BlazorMode)' == ''">WebAssembly</BlazorMode>
  </PropertyGroup>

</Project>
