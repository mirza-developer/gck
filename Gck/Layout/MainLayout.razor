@using Gck.Components
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager Navigation

<div class="page">
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <i class="fas fa-gamepad"></i>
                گیم سنتر کوثر
            </a>

            <ul class="nav-menu">
                @if (!isLoggedIn)
                {
                    <li class="nav-item">
                        <a href="/" class="nav-link">
                            <i class="fas fa-home"></i>
                            خانه
                        </a>
                    </li>
                    <li class="nav-item has-dropdown">
                        <a href="/games" class="nav-link">
                            <i class="fas fa-gamepad"></i>
                            بازی‌ها
                            <i class="fas fa-chevron-down dropdown-arrow"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/games/action" class="dropdown-item"><i class="fas fa-fist-raised"></i> اکشن</a></li>
                            <li><a href="/games/sports" class="dropdown-item"><i class="fas fa-futbol"></i> ورزشی</a></li>
                            <li><a href="/games/racing" class="dropdown-item"><i class="fas fa-car"></i> مسابقه‌ای</a></li>
                            <li><a href="/games/adventure" class="dropdown-item"><i class="fas fa-compass"></i> ماجراجویی</a></li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a href="/management" class="nav-link">
                            <i class="fas fa-chart-line"></i>
                            داشبورد
                        </a>
                    </li>
                    <li class="nav-item has-dropdown">
                        <a href="#" class="nav-link" @onclick:preventDefault>
                            <i class="fas fa-cog"></i>
                            مدیریت
                            <i class="fas fa-chevron-down dropdown-arrow"></i>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a href="/users" class="dropdown-item"><i class="fas fa-users"></i> کاربران</a></li>
                            <li><a href="/tables" class="dropdown-item"><i class="fas fa-table"></i> میزها</a></li>
                            <li><a href="/customers" class="dropdown-item"><i class="fas fa-user-friends"></i> مشتریان</a></li>
                            <li><a href="/financialaccounts" class="dropdown-item"><i class="fas fa-wallet"></i> حساب‌های مالی</a></li>
                        </ul>
                    </li>
                }
            </ul>

            <div class="nav-actions">
                @if (isLoggedIn)
                {
                    <span class="user-name">@currentUserName</span>
                    <button class="btn-logout" @onclick="HandleLogout">
                        <i class="fas fa-sign-out-alt"></i>
                        خروج
                    </button>
                }
                else
                {
                    <a href="/login" class="btn-login-nav">
                        <i class="fas fa-sign-in-alt"></i>
                        ورود
                    </a>
                }
            </div>

            <button class="mobile-menu-toggle" @onclick="ToggleMobileMenu">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
    @if (!isLoggedIn)
    {
        <footer class="footer">
            <div class="container">
                <div class="footer-content">
                    <div class="footer-section">
                        <h3>گیم سنتر کوثر</h3>
                        <p>بهترین تجربه گیمینگ با جدیدترین بازی‌های روز دنیا</p>
                        <div class="social-links">
                            <a href="https://instagram.com/kowsar_gc" class="social-link" target="_blank"><i class="fab fa-instagram"></i></a>
                            <a href="https://t.me/kowsar_gc" class="social-link" target="_blank"><i class="fab fa-telegram"></i></a>
                        </div>
                    </div>
                    <div class="footer-section">
                        <h4>دسته‌بندی بازی‌ها</h4>
                        <ul class="footer-links">
                            <li>اکشن</li>
                            <li>ورزشی</li>
                            <li>مسابقه‌ای</li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4>پشتیبانی</h4>
                        <ul class="footer-links">
                            <li><a href="/help">راهنما</a></li>
                            <li><a href="/contact">تماس با ما</a></li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4>موقعیت ما روی نقشه</h4>
                        <div id="footer-map" style="width:100%;height:220px;border-radius:16px;overflow:hidden;"></div>
                    </div>
                </div>

                <div class="footer-bottom">
                    <p>&copy; ۱۴۰۴ گیم سنتر کوثر. تمامی حقوق محفوظ است.</p>
                </div>
            </div>
        </footer>
    }
</div>

@code {
    private bool isLoggedIn = false;
    private string currentUserName = string.Empty;
    private bool isMobileMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckLoginStatus();
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initFooterMap");
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CheckLoginStatus();
        StateHasChanged();
    }

    private async Task CheckLoginStatus()
    {
        var user = await LocalStorage.GetItemAsync<string>("currentUser");
        var name = await LocalStorage.GetItemAsync<string>("currentUserName");
        isLoggedIn = !string.IsNullOrEmpty(user);
        currentUserName = name ?? user ?? string.Empty;
    }

    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("currentUser");
        await LocalStorage.RemoveItemAsync("currentUserId");
        await LocalStorage.RemoveItemAsync("currentUserName");
        Navigation.NavigateTo("/login", true);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
