@page "/referrals"
@using Gck.Resources
@using Gck.Components
@using Gck.Application.DTOs

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-user-plus"></i>
                @PersianResources.AllReferralsManagement
            </h2>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else
        {
            <!-- Pending Referrals Section -->
            <div class="gaming-card fade-in-up" style="margin-bottom: 2rem;">
                <div class="grid-details-header">
                    <i class="fas fa-clock"></i>
                    <h4>@PersianResources.PendingReferrals (@pendingReferrals.Count)</h4>
                </div>

                @if (pendingReferrals.Any())
                {
                    <div class="data-grid">
                        <table class="data-grid-table">
                            <thead class="data-grid-header">
                                <tr>
                                    <th>@PersianResources.CustomerName</th>
                                    <th>@PersianResources.Phone</th>
                                    <th>@PersianResources.ReferredByCustomer</th>
                                    <th>@PersianResources.ReferralRewardPercentage</th>
                                    <th>@PersianResources.Actions</th>
                                </tr>
                            </thead>
                            <tbody class="data-grid-body">
                                @foreach (var customer in pendingReferrals)
                                {
                                    <tr>
                                        <td><span class="grid-cell-primary">@customer.Name</span></td>
                                        <td><span class="grid-cell-secondary">@customer.PhoneNumber</span></td>
                                        <td>
                                            <span class="grid-cell-badge" style="background: rgba(100,100,255,0.2); color: #8888ff;">
                                                <i class="fas fa-user"></i>
                                                @(customer.ReferredByCustomerName ?? "-")
                                            </span>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-input"
                                                   style="width: 100px;"
                                                   min="0" max="100" step="1"
                                                   value="@GetPendingPercentage(customer.Id)"
                                                   @onchange="@(e => SetPendingPercentage(customer.Id, e.Value?.ToString()))" />
                                        </td>
                                        <td>
                                            <div class="grid-actions">
                                                <button class="grid-action-btn edit" @onclick="() => VerifyReferral(customer.Id)">
                                                    <i class="fas fa-check"></i>
                                                    @PersianResources.VerifyReferral
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-check-circle"></i>
                        <p>هیچ معرفی در انتظار تایید وجود ندارد</p>
                    </div>
                }
            </div>

            <!-- All Customers with Referral Info -->
            <div class="gaming-card fade-in-up">
                <div class="grid-details-header">
                    <i class="fas fa-users"></i>
                    <h4>مشتریان با معرف (تنظیم درصد پاداش)</h4>
                </div>
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           placeholder="@PersianResources.SearchCustomers"
                           @bind="searchText"
                           @bind:event="oninput"
                           class="search-input" />
                </div>

                @if (FilteredReferredCustomers.Any())
                {
                    <div class="data-grid">
                        <table class="data-grid-table">
                            <thead class="data-grid-header">
                                <tr>
                                    <th>@PersianResources.CustomerName</th>
                                    <th>@PersianResources.Phone</th>
                                    <th>@PersianResources.ReferredByCustomer</th>
                                    <th>@PersianResources.IsVerifiedByAdmin</th>
                                    <th>@PersianResources.RewardPercentage (%)</th>
                                    <th>@PersianResources.Actions</th>
                                </tr>
                            </thead>
                            <tbody class="data-grid-body">
                                @foreach (var customer in FilteredReferredCustomers)
                                {
                                    <tr>
                                        <td><span class="grid-cell-primary">@customer.Name</span></td>
                                        <td><span class="grid-cell-secondary">@customer.PhoneNumber</span></td>
                                        <td>
                                            <span class="grid-cell-badge" style="background: rgba(100,100,255,0.2); color: #8888ff;">
                                                <i class="fas fa-user"></i>
                                                @(customer.ReferredByCustomerName ?? "-")
                                            </span>
                                        </td>
                                        <td>
                                            @if (customer.IsVerifiedByAdmin)
                                            {
                                                <span class="grid-cell-badge" style="background: rgba(0,200,0,0.2); color: #00cc00; border: 1px solid rgba(0,200,0,0.3);">
                                                    <i class="fas fa-check"></i>
                                                    @PersianResources.Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="grid-cell-badge" style="background: rgba(255,165,0,0.2); color: orange; border: 1px solid rgba(255,165,0,0.3);">
                                                    <i class="fas fa-clock"></i>
                                                    @PersianResources.ReferralPending
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-input"
                                                   style="width: 100px;"
                                                   min="0" max="100" step="1"
                                                   value="@customer.ReferralRewardPercentage"
                                                   @onchange="@(e => SetVerifiedPercentage(customer.Id, e.Value?.ToString()))" />
                                        </td>
                                        <td>
                                            <div class="grid-actions">
                                                <button class="grid-action-btn edit" @onclick="() => SaveRewardPercentage(customer)">
                                                    <i class="fas fa-save"></i>
                                                    @PersianResources.Save
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>مشتری با معرف یافت نشد</p>
                    </div>
                }
            </div>
        }
    </div>
</section>
