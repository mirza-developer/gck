@inject HttpClient Http
@inject ApiConfigurationService ApiConfig
@using System.Net.Http.Json
@using Gck.Shared.Modals
@using Gck.Resources

<Modal @bind-IsVisible="isVisible"
       Title="@PersianResources.StartSession"
       ShowFooter="false"
       CloseOnOverlayClick="@(!submitting)"
       Size="ModalSize.Medium">
    @if (loading)
    {
        <div class="text-center">
            <i class="fas fa-spinner fa-spin" style="font-size: 2rem;"></i>
            <p>@PersianResources.Loading</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">
            <i class="fas fa-exclamation-triangle"></i>
            @errorMessage
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-table"></i>
                    @PersianResources.Table
                </label>
                <input type="text" class="form-input" value="@TableName" disabled />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-gamepad"></i>
                    @PersianResources.SeatsCount
                </label>
                <select class="form-input" @bind="model.SeatsCount" @bind:after="OnSeatsCountChanged">
                    @foreach (var fee in hourlyFees)
                    {
                        <option value="@fee.SeatsCount">@fee.SeatsCount @PersianResources.PersonSuffix - @fee.Fee.ToString("N0") @PersianResources.TomanPerHour</option>
                    }
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-users"></i>
                    @PersianResources.CustomersOptional
                </label>
                @if (customers.Any())
                {
                    <div class="multiselect-dropdown" @ref="dropdownRef">
                        <div class="multiselect-input" @onclick="ToggleDropdown">
                            <div class="multiselect-selected">
                                @if (model.CustomerIds.Any())
                                {
                                    @foreach (var customerId in model.CustomerIds)
                                    {
                                        var customer = customers.FirstOrDefault(c => c.Id == customerId);
                                        if (customer != null)
                                        {
                                            <span class="multiselect-tag">
                                                @customer.Name
                                                <i class="fas fa-times" @onclick="@(e => RemoveCustomer(customerId))" @onclick:stopPropagation="true"></i>
                                            </span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="multiselect-placeholder">@PersianResources.CustomersOptional</span>
                                }
                            </div>
                            <i class="fas @(isDropdownOpen ? "fa-chevron-up" : "fa-chevron-down") multiselect-arrow"></i>
                        </div>
                        
                        @if (isDropdownOpen)
                        {
                            <div class="multiselect-options">
                                @foreach (var customer in customers)
                                {
                                    <div class="multiselect-option @(model.CustomerIds.Contains(customer.Id) ? "selected" : "")"
                                         @onclick="@(() => ToggleCustomer(customer.Id))">
                                        <input type="checkbox" 
                                               checked="@model.CustomerIds.Contains(customer.Id)"
                                               @onclick:stopPropagation="true"
                                               @onchange="@(e => ToggleCustomer(customer.Id))" />
                                        <span>@customer.Name (@customer.PhoneNumber)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-secondary">@PersianResources.NoCustomersRegistered</p>
                }
            </div>

            @if (successMessage != null)
            {
                <div class="success-message">
                    <i class="fas fa-check-circle"></i>
                    @successMessage
                </div>
            }

            <div class="modal-actions">
                <button type="submit" class="btn-gaming" disabled="@submitting">
                    @if (submitting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>@PersianResources.Submitting</span>
                    }
                    else
                    {
                        <i class="fas fa-play"></i>
                        <span>@PersianResources.StartSession</span>
                    }
                </button>
                <button type="button" class="btn-gaming btn-secondary" @onclick="Close" disabled="@submitting">
                    <i class="fas fa-times"></i>
                    <span>@PersianResources.Cancel</span>
                </button>
            </div>
        </EditForm>
    }
</Modal>

<style>
    .multiselect-dropdown {
        position: relative;
        width: 100%;
    }

    .multiselect-input {
        width: 100%;
        min-height: 3rem;
        padding: 0.5rem 2.5rem 0.5rem 1.2rem;
        background: rgba(26, 26, 46, 0.6);
        border: 1px solid rgba(108, 92, 231, 0.3);
        border-radius: 12px;
        color: var(--text-primary);
        font-family: 'Vazirmatn', sans-serif;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        position: relative;
    }

    .multiselect-input:hover {
        border-color: var(--primary-purple);
    }

    .multiselect-input:focus-within {
        outline: none;
        border-color: var(--primary-purple);
        background: rgba(26, 26, 46, 0.9);
        box-shadow: 0 0 15px rgba(108, 92, 231, 0.3);
    }

    .multiselect-selected {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .multiselect-placeholder {
        color: var(--text-secondary);
    }

    .multiselect-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, rgba(108, 92, 231, 0.3), rgba(253, 121, 168, 0.3));
        color: var(--text-primary);
        padding: 0.3rem 0.7rem;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1px solid rgba(108, 92, 231, 0.4);
    }

    .multiselect-tag i {
        cursor: pointer;
        font-size: 0.8rem;
        transition: color 0.2s;
    }

    .multiselect-tag i:hover {
        color: var(--secondary-pink);
    }

    .multiselect-arrow {
        position: absolute;
        left: 1rem;
        color: var(--text-secondary);
        transition: transform 0.3s ease;
        pointer-events: none;
    }

    .multiselect-options {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        right: 0;
        max-height: 250px;
        overflow-y: auto;
        background: rgba(26, 26, 46, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(108, 92, 231, 0.4);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        z-index: 1000;
        animation: dropdownSlide 0.3s ease;
    }

    @@keyframes dropdownSlide {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .multiselect-options::-webkit-scrollbar {
        width: 8px;
    }

    .multiselect-options::-webkit-scrollbar-track {
        background: rgba(26, 26, 46, 0.5);
        border-radius: 10px;
    }

    .multiselect-options::-webkit-scrollbar-thumb {
        background: var(--primary-purple);
        border-radius: 10px;
    }

    .multiselect-option {
        padding: 0.8rem 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(108, 92, 231, 0.1);
    }

    .multiselect-option:last-child {
        border-bottom: none;
    }

    .multiselect-option:hover {
        background: rgba(108, 92, 231, 0.2);
    }

    .multiselect-option.selected {
        background: rgba(108, 92, 231, 0.3);
    }

    .multiselect-option input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: var(--primary-purple);
    }

    .multiselect-option span {
        flex: 1;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .modal-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .text-secondary {
        color: var(--text-secondary);
    }
</style>

@code {
    [Parameter] public int TableId { get; set; }
    [Parameter] public string TableName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSessionStarted { get; set; }

    private bool isVisible;
    private bool loading = true;
    private bool submitting;
    private string? errorMessage;
    private string? successMessage;
    private bool isDropdownOpen;

    private List<HourlyFeeDto> hourlyFees = new();
    private List<CustomerDto> customers = new();
    private decimal? selectedFee;

    private ElementReference dropdownRef;

    private StartSessionModel model = new();

    private class StartSessionModel
    {
        public int SeatsCount { get; set; } = 1;
        public List<int> CustomerIds { get; set; } = new();
    }

    public async Task Show()
    {
        model = new StartSessionModel { SeatsCount = 1 };
        errorMessage = null;
        successMessage = null;
        isVisible = true;
        loading = true;
        isDropdownOpen = false;

        await LoadData();
    }

    public void Close()
    {
        isVisible = false;
        isDropdownOpen = false;
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;

            // Load hourly fees
            var feesResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/hourlyfees"));
            if (feesResponse.IsSuccessStatusCode)
            {
                hourlyFees = await feesResponse.Content.ReadFromJsonAsync<List<HourlyFeeDto>>() ?? new();
                hourlyFees = hourlyFees.OrderBy(f => f.SeatsCount).ToList();
                
                if (hourlyFees.Any())
                {
                    model.SeatsCount = hourlyFees.First().SeatsCount;
                    selectedFee = hourlyFees.First().Fee;
                }
            }

            // Load customers
            var customersResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/customers"));
            if (customersResponse.IsSuccessStatusCode)
            {
                customers = await customersResponse.Content.ReadFromJsonAsync<List<CustomerDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.LoadingError}: {ex.Message}";
            loading = false;
        }
    }

    private void OnSeatsCountChanged()
    {
        var fee = hourlyFees.FirstOrDefault(f => f.SeatsCount == model.SeatsCount);
        selectedFee = fee?.Fee;
    }

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void ToggleCustomer(int customerId)
    {
        if (model.CustomerIds.Contains(customerId))
        {
            model.CustomerIds.Remove(customerId);
        }
        else
        {
            model.CustomerIds.Add(customerId);
        }
    }

    private void RemoveCustomer(int customerId)
    {
        model.CustomerIds.Remove(customerId);
    }

    private async Task HandleSubmit()
    {
        try
        {
            submitting = true;
            errorMessage = null;
            successMessage = null;
            isDropdownOpen = false;

            var command = new
            {
                tableId = TableId,
                seatsCount = model.SeatsCount,
                customerIds = model.CustomerIds.Any() ? model.CustomerIds : null
            };

            var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/sessions/start"), command);

            if (response.IsSuccessStatusCode)
            {
                successMessage = PersianResources.SessionStartedSuccess;
                await Task.Delay(1000);
                await OnSessionStarted.InvokeAsync();
                Close();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"{PersianResources.ErrorStartingSession}: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.ErrorStartingSession}: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }

    // DTOs
    private class HourlyFeeDto
    {
        public int Id { get; set; }
        public int SeatsCount { get; set; }
        public decimal Fee { get; set; }
    }

    private class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
