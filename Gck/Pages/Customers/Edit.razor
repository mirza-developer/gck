@page "/customers/edit/{id:int}"
@using Gck.Resources
@using Gck.Components

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-edit"></i>
                @PersianResources.EditCustomer
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (command == null)
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @PersianResources.CustomerNotFound
            </div>
        }
        else
        {
            <div class="gaming-card fade-in-up">
                <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-id-card"></i>
                            @PersianResources.CustomerName <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.Name" class="form-input" placeholder="@PersianResources.CustomerNamePlaceholder" />
                        <ValidationMessage For="@(() => command.Name)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-phone"></i>
                            @PersianResources.PhoneNumber <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.PhoneNumber" class="form-input" placeholder="@PersianResources.PhonePlaceholder" />
                        <ValidationMessage For="@(() => command.PhoneNumber)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-calendar-alt"></i>
                            @PersianResources.BirthYear <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputNumber @bind-Value="command.BirthYear" class="form-input" placeholder="@PersianResources.BirthYearPlaceholder" />
                        <ValidationMessage For="@(() => command.BirthYear)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-venus-mars"></i>
                            @PersianResources.Gender <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputSelect @bind-Value="command.Gender" class="form-input">
                            <option value="Male">@PersianResources.Male</option>
                            <option value="Female">@PersianResources.Female</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => command.Gender)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <div class="form-checkbox-group">
                            <InputCheckbox @bind-Value="command.IsLoyal" id="isLoyal" class="form-checkbox" @onchange="OnLoyaltyToggle" />
                            <label for="isLoyal" class="form-label" style="margin-bottom: 0;">
                                <i class="fas fa-star"></i>
                                @PersianResources.EnableLoyaltyProgram
                            </label>
                        </div>
                    </div>

                    @if (command.IsLoyal)
                    {
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-gift"></i>
                                @PersianResources.SessionsRequiredForFree <span class="required">@PersianResources.Required</span>
                            </label>
                            <InputNumber @bind-Value="command.SessionsRequiredForFree" class="form-input" placeholder="@PersianResources.SessionsRequiredPlaceholder" />
                            <ValidationMessage For="@(() => command.SessionsRequiredForFree)" class="validation-error" />
                        </div>
                    }

                    <div class="form-group">
                        <div class="form-checkbox-group">
                            <InputCheckbox @bind-Value="command.IsVerifiedByAdmin" id="isVerified" class="form-checkbox" />
                            <label for="isVerified" class="form-label" style="margin-bottom: 0;">
                                <i class="fas fa-check-circle"></i>
                                @PersianResources.IsVerifiedByAdmin
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-percent"></i>
                            @PersianResources.ReferralRewardPercentage
                        </label>
                        <InputNumber @bind-Value="command.ReferralRewardPercentage" class="form-input" placeholder="@PersianResources.ReferralRewardPercentagePlaceholder" min="0" max="100" />
                        <small style="color: #888;">درصد پاداش پرداختی‌های این مشتری که به معرف او تعلق می‌گیرد (۰ تا ۱۰۰)</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>@PersianResources.Saving</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>@PersianResources.SaveChanges</span>
                            }
                        </button>
                        <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                            <i class="fas fa-times"></i>
                            @PersianResources.Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</section>
