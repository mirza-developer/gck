@page "/financialaccounts/edit/{id:int}"
@using Gck.Resources
@using Gck.Components

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-edit"></i>
                @PersianResources.EditFinancialAccount
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (command == null)
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @PersianResources.FinancialAccountNotFound
            </div>
        }
        else
        {
            <div class="gaming-card fade-in-up">
                <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-id-badge"></i>
                            @PersianResources.AccountName <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.AccountName" class="form-input" placeholder="@PersianResources.AccountNamePlaceholder" />
                        <ValidationMessage For="@(() => command.AccountName)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-credit-card"></i>
                            @PersianResources.CardNumber <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.CardNumber" class="form-input" placeholder="@PersianResources.CardNumberPlaceholder" />
                        <ValidationMessage For="@(() => command.CardNumber)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-university"></i>
                            @PersianResources.BankName <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.BankName" class="form-input" placeholder="@PersianResources.BankNamePlaceholder" />
                        <ValidationMessage For="@(() => command.BankName)" class="validation-error" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>@PersianResources.Saving</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>@PersianResources.SaveChanges</span>
                            }
                        </button>
                        <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                            <i class="fas fa-times"></i>
                            @PersianResources.Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</section>
