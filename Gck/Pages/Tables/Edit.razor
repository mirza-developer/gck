@page "/tables/edit/{id:int}"
@using Gck.Application.DTOs
@using Gck.Application.Features.Tables.Commands.UpdateTable
@using Gck.Application.Features.Tables.Queries.GetTableById
@using Gck.Resources
@using Gck.Services
@using Gck.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ApiConfigurationService ApiConfig
@inject INotificationService NotificationService

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-edit"></i>
                @PersianResources.EditTable
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="gaming-loader">
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <p class="loader-text">@PersianResources.Loading</p>
                </div>
            </div>
        }
        else if (command == null)
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @PersianResources.TableNotFound
            </div>
        }
        else
        {
            <div class="gaming-card fade-in-up">
                <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tag"></i>
                            @PersianResources.TableName <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputText @bind-Value="command.Name" class="form-input" placeholder="@PersianResources.TableNamePlaceholder" />
                        <ValidationMessage For="@(() => command.Name)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-gamepad"></i>
                            @PersianResources.NumberOfControllers <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputNumber @bind-Value="command.NumberOfControllers" class="form-input" placeholder="@PersianResources.ControllersPlaceholder" />
                        <ValidationMessage For="@(() => command.NumberOfControllers)" class="validation-error" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-money-bill-wave"></i>
                            @PersianResources.HourlyFeePerController <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputNumber @bind-Value="command.HourlyFeePerController" class="form-input" placeholder="@PersianResources.HourlyFeePlaceholder" />
                        <ValidationMessage For="@(() => command.HourlyFeePerController)" class="validation-error" />
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>@PersianResources.Saving</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>@PersianResources.SaveChanges</span>
                            }
                        </button>
                        <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                            <i class="fas fa-times"></i>
                            @PersianResources.Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateTableCommand? command;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTable();
    }

    private async Task LoadTable()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.GetAsync(ApiConfig.GetApiUrl($"/api/tables/{Id}"));

            if (response.IsSuccessStatusCode)
            {
                var table = await response.Content.ReadFromJsonAsync<TableDto>();
                if (table != null)
                {
                    command = new UpdateTableCommand
                    {
                        Id = table.Id,
                        Name = table.Name,
                        NumberOfControllers = table.NumberOfControllers,
                        HourlyFeePerController = table.HourlyFeePerController
                    };
                }
            }
            else
            {
                NotificationService.ShowError(PersianResources.TableNotFound);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"{PersianResources.ApiConnectionError}: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (command == null) return;

        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            var response = await Http.PutAsJsonAsync(ApiConfig.GetApiUrl($"/api/tables/{command.Id}"), command);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.ShowSuccess(PersianResources.SaveSuccess);
                await Task.Delay(1500);
                Navigation.NavigateTo("/tables");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.ShowError($"{PersianResources.Error}: {error}");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"{PersianResources.ApiConnectionError}: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/tables");
    }
}
