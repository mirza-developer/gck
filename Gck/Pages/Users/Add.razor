@page "/users/add"
@using Gck.Application.Features.Users.Commands.AddUser
@using Gck.Services
@using Gck.Enums
@using Gck.Extensions
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ApiConfigurationService ApiConfig
@inject INotificationService NotificationService

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-user-plus"></i>
                افزودن کاربر جدید
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                بازگشت
            </button>
        </div>

        <div class="gaming-card fade-in-up">
            <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-user"></i>
                        نام کاربری <span class="required">*</span>
                    </label>
                    <InputText @bind-Value="command.Username" class="form-input" placeholder="نام کاربری را وارد کنید" />
                    <ValidationMessage For="@(() => command.Username)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-id-card"></i>
                        نام کامل <span class="required">*</span>
                    </label>
                    <InputText @bind-Value="command.Name" class="form-input" placeholder="نام کامل را وارد کنید" />
                    <ValidationMessage For="@(() => command.Name)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i>
                        رمز عبور <span class="required">*</span>
                    </label>
                    <InputText type="password" @bind-Value="command.Password" class="form-input" placeholder="رمز عبور را وارد کنید" />
                    <ValidationMessage For="@(() => command.Password)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i>
                        ایمیل
                    </label>
                    <InputText @bind-Value="command.Email" class="form-input" placeholder="example@email.com" />
                    <ValidationMessage For="@(() => command.Email)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-phone"></i>
                        شماره تلفن
                    </label>
                    <InputText @bind-Value="command.PhoneNumber" class="form-input" placeholder="09123456789" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-sticky-note"></i>
                        جزئیات اضافی
                    </label>
                    <InputTextArea @bind-Value="command.Details" class="form-textarea" placeholder="توضیحات و جزئیات اضافی..." rows="4" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>در حال ثبت...</span>
                        }
                        else
                        {
                            <i class="fas fa-save"></i>
                            <span>ثبت کاربر</span>
                        }
                    </button>
                    <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                        <i class="fas fa-times"></i>
                        انصراف
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private AddUserCommand command = new();
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        await Http.PostAsJsonWithExceptionAsync(ApiConfig.GetApiUrl("/api/user"), command);

        NotificationService.ShowSuccess("کاربر با موفقیت ایجاد شد");
        await Task.Delay(1500);
        Navigation.NavigateTo("/users");

        isSubmitting = false;
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/users");
    }
}
