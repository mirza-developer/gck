@page "/users/add"
@using Gck.Resources

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-user-plus"></i>
                @PersianResources.AddNewUser
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        <div class="gaming-card fade-in-up">
            <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-user"></i>
                        @PersianResources.Username <span class="required">@PersianResources.Required</span>
                    </label>
                    <InputText @bind-Value="command.Username" class="form-input" placeholder="@PersianResources.EnterUsername" />
                    <ValidationMessage For="@(() => command.Username)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-id-card"></i>
                        @PersianResources.UserFullName <span class="required">@PersianResources.Required</span>
                    </label>
                    <InputText @bind-Value="command.Name" class="form-input" placeholder="@PersianResources.UserFullName" />
                    <ValidationMessage For="@(() => command.Name)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-lock"></i>
                        @PersianResources.Password <span class="required">@PersianResources.Required</span>
                    </label>
                    <InputText type="password" @bind-Value="command.Password" class="form-input" placeholder="@PersianResources.EnterPassword" />
                    <ValidationMessage For="@(() => command.Password)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i>
                        @PersianResources.Email
                    </label>
                    <InputText @bind-Value="command.Email" class="form-input" placeholder="example@email.com" />
                    <ValidationMessage For="@(() => command.Email)" class="validation-error" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-phone"></i>
                        @PersianResources.PhoneNumber
                    </label>
                    <InputText @bind-Value="command.PhoneNumber" class="form-input" placeholder="@PersianResources.PhonePlaceholder" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-sticky-note"></i>
                        @PersianResources.AdditionalDetails
                    </label>
                    <InputTextArea @bind-Value="command.Details" class="form-textarea" placeholder="@PersianResources.AdditionalDetails" rows="4" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>@PersianResources.Submitting</span>
                        }
                        else
                        {
                            <i class="fas fa-save"></i>
                            <span>@PersianResources.SubmitUser</span>
                        }
                    </button>
                    <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                        <i class="fas fa-times"></i>
                        @PersianResources.Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</section>
