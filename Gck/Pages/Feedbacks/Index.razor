@page "/feedbacks"
@using Gck.Resources
@using Gck.Components

<section class="section">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-comments"></i>
                @PersianResources.CustomerFeedbacks
            </h1>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (feedbacks != null && feedbacks.Any())
        {
            <div class="feedbacks-grid">
                @foreach (var feedback in feedbacks)
                {
                    <div class="gaming-card feedback-card @(feedback.IsRead ? "read" : "unread")">
                        <div class="feedback-header">
                            <div class="feedback-info">
                                <h3>@feedback.Subject</h3>
                                <p class="customer-info">
                                    <i class="fas fa-user"></i>
                                    @feedback.CustomerName
                                    <span class="separator">•</span>
                                    <i class="fas fa-phone"></i>
                                    @feedback.CustomerPhone
                                </p>
                                <p class="submitted-date">
                                    <i class="fas fa-calendar"></i>
                                    @feedback.SubmittedAt.ToString("yyyy/MM/dd HH:mm")
                                </p>
                            </div>
                            <div class="feedback-status">
                                @if (feedback.IsRead)
                                {
                                    <span class="badge badge-read">
                                        <i class="fas fa-check-circle"></i>
                                        @PersianResources.Read
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-unread">
                                        <i class="fas fa-circle"></i>
                                        @PersianResources.Unread
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="feedback-message">
                            <p>@feedback.Message</p>
                        </div>
                        @if (!feedback.IsRead)
                        {
                            <div class="feedback-actions">
                                <button class="btn-gaming btn-sm" @onclick="() => MarkAsRead(feedback.Id)">
                                    <i class="fas fa-check"></i>
                                    @PersianResources.MarkAsRead
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="gaming-card">
                <p class="no-data">@PersianResources.NoFeedbacksYet</p>
            </div>
        }
    </div>
</section>
