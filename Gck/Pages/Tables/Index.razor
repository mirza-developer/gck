@page "/tables"
@using Gck.Resources
@using Gck.Shared.Modals
@using Gck.Components

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-table"></i>
                @PersianResources.TablesManagement
            </h2>
            <button class="btn-gaming" @onclick="NavigateToAdd">
                <i class="fas fa-plus"></i>
                @PersianResources.AddNewTable
            </button>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else
        {
            <div class="gaming-card fade-in-up">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" 
                           placeholder="@PersianResources.SearchTables" 
                           @bind="searchText" 
                           @bind:event="oninput"
                           class="search-input" />
                </div>

                @if (FilteredTables.Any())
                {
                    <div class="users-grid">
                        @foreach (var table in FilteredTables)
                        {
                            <div class="user-card fade-in-up">
                                <div class="user-header">
                                    <div class="user-avatar">
                                        <i class="fas fa-table"></i>
                                    </div>
                                    <div class="user-info">
                                        <h3 class="user-name">@table.Name</h3>
                                        <p class="user-username">@PersianResources.ControllersCount: @table.NumberOfControllers - @PersianResources.HourlyFee: @table.HourlyFeePerController.ToString("N0") @PersianResources.Toman</p>
                                    </div>
                                    <div class="user-status @(table.IsOccupied ? "inactive" : "active")">
                                        @(table.IsOccupied ? PersianResources.TableOccupied : PersianResources.TableAvailable)
                                    </div>
                                </div>
                                <div class="user-actions">
                                    <button class="btn-action btn-edit" @onclick="() => NavigateToEdit(table.Id)">
                                        <i class="fas fa-edit"></i>
                                        @PersianResources.Edit
                                    </button>
                                    <button class="btn-action btn-delete" @onclick="() => ShowDeleteConfirmation(table.Id)">
                                        <i class="fas fa-trash"></i>
                                        @PersianResources.Delete
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>@PersianResources.NoTablesFound</p>
                    </div>
                }
            </div>
        }
    </div>
</section>

<Modal @bind-IsVisible="showDeleteModal"
       Title="@PersianResources.DeleteTableConfirm"
       ConfirmText="@PersianResources.Delete"
       CancelText="@PersianResources.Cancel"
       OnConfirm="ConfirmDelete"
       Size="ModalSize.Small">
    <p style="text-align: center; color: var(--text-primary);">
        ??? ???? ????? ?????? ?? ??? ??? ????? ????
    </p>
</Modal>
