@inject HttpClient Http
@inject ApiConfigurationService ApiConfig
@using System.Net.Http.Json
@using Gck.Shared.Modals
@using Gck.Resources

<Modal @bind-IsVisible="isVisible"
       Title="@PersianResources.StartSession"
       ShowFooter="false"
       CloseOnOverlayClick="@(!submitting)"
       Size="ModalSize.Medium">
    @if (loading)
    {
        <div class="text-center">
            <i class="fas fa-spinner fa-spin" style="font-size: 2rem;"></i>
            <p>@PersianResources.Loading</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">
            <i class="fas fa-exclamation-triangle"></i>
            @errorMessage
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-table"></i>
                    @PersianResources.Table
                </label>
                <input type="text" class="form-input" value="@TableName" disabled />
            </div>
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-users"></i>
                    @PersianResources.CustomersOptional
                </label>
                @if (customers.Any())
                {
                    <MultiSelectDropdown TItem="CustomerDto"
                                         TValue="int"
                                         Items="@customers"
                                         IsMultiSelect="true"
                                         EnableSearch="true"
                                         @bind-SelectedValues="@model.CustomerIds"
                                         ValueSelector="@(customer => customer.Id)"
                                         DisplayTextSelector="@(customer => $"{customer.Name} ({customer.PhoneNumber})")"
                                         Placeholder="@PersianResources.CustomersOptional"
                                         SearchPlaceholder="@PersianResources.Search"
                                         NoResultsText="@PersianResources.NoCustomersFound"
                                         @bind-SelectedValues:after="OnCustomersOrCountChanged" />
                }
                else
                {
                    <p class="text-secondary">@PersianResources.NoCustomersRegistered</p>
                }
            </div>
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-user-plus"></i>
                    @PersianResources.AnonymousCustomersCount
                </label>
                <div class="count-control">
                    <button type="button" class="count-btn" @onclick="DecrementAnonymousCount" disabled="@(model.AnonymousCustomersCount <= 0)">
                        <i class="fas fa-minus"></i>
                    </button>
                    <input type="number" 
                           class="count-input" 
                           @bind="model.AnonymousCustomersCount" 
                           @bind:after="OnCustomersOrCountChanged"
                           min="0" />
                    <button type="button" class="count-btn" @onclick="IncrementAnonymousCount">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-gamepad"></i>
                    @PersianResources.SeatsCount
                </label>
                <div class="fee-display">
                    <div class="fee-info">
                        <div class="fee-breakdown">
                            @if (model.CustomerIds.Any())
                            {
                                <span class="fee-detail">
                                    <i class="fas fa-users"></i>
                                    @model.CustomerIds.Count @PersianResources.RegisteredCustomer
                                </span>
                            }
                            @if (model.AnonymousCustomersCount > 0)
                            {
                                <span class="fee-detail">
                                    <i class="fas fa-user-plus"></i>
                                    @model.AnonymousCustomersCount @PersianResources.AnonymousCustomer
                                </span>
                            }
                            <span class="fee-total">
                                <i class="fas fa-equals"></i>
                                @model.SeatsCount @PersianResources.PersonSuffix
                            </span>
                        </div>
                        @if (selectedFee.HasValue)
                        {
                            <span class="fee-amount">@selectedFee.Value.ToString("N0") @PersianResources.TomanPerHour</span>
                        }
                    </div>
                </div>
            </div>
            @if (successMessage != null)
            {
                <div class="success-message">
                    <i class="fas fa-check-circle"></i>
                    @successMessage
                </div>
            }

            <div class="modal-actions">
                <button type="submit" class="btn-gaming" disabled="@submitting">
                    @if (submitting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>@PersianResources.Submitting</span>
                    }
                    else
                    {
                        <i class="fas fa-play"></i>
                        <span>@PersianResources.StartSession</span>
                    }
                </button>
                <button type="button" class="btn-gaming btn-secondary" @onclick="Close" disabled="@submitting">
                    <i class="fas fa-times"></i>
                    <span>@PersianResources.Cancel</span>
                </button>
            </div>
        </EditForm>
    }
</Modal>

<style>
    .modal-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .text-secondary {
        color: var(--text-secondary);
    }

    .count-control {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
    }

    .count-btn {
        width: 3rem;
        height: 3rem;
        background: rgba(26, 26, 46, 0.6);
        border: 1px solid rgba(108, 92, 231, 0.3);
        border-radius: 12px;
        color: var(--text-primary);
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .count-btn:hover:not(:disabled) {
        border-color: var(--primary-purple);
        background: rgba(108, 92, 231, 0.2);
        transform: translateY(-2px);
    }

    .count-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .count-input {
        flex: 1;
        height: 3rem;
        padding: 0.5rem 1.2rem;
        background: rgba(26, 26, 46, 0.6);
        border: 1px solid rgba(108, 92, 231, 0.3);
        border-radius: 12px;
        color: var(--text-primary);
        font-family: 'Vazirmatn', sans-serif;
        font-size: 1.2rem;
        text-align: center;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .count-input:focus {
        outline: none;
        border-color: var(--primary-purple);
        background: rgba(26, 26, 46, 0.9);
        box-shadow: 0 0 15px rgba(108, 92, 231, 0.3);
    }

    .count-input::-webkit-inner-spin-button,
    .count-input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .fee-display {
        width: 100%;
        padding: 1rem 1.2rem;
        background: rgba(26, 26, 46, 0.6);
        border: 1px solid rgba(108, 92, 231, 0.3);
        border-radius: 12px;
        min-height: 3rem;
        display: flex;
        align-items: center;
    }

    .fee-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        flex-wrap: wrap;
    }

    .fee-breakdown {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .fee-detail {
        color: var(--text-secondary);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .fee-detail i {
        color: var(--primary-purple);
    }

    .fee-total {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .fee-total i {
        color: var(--secondary-pink);
    }

    .fee-amount {
        color: var(--primary-purple);
        font-weight: 600;
        font-size: 1.1rem;
        margin-right: auto;
    }
</style>

@code {
    [Parameter] public int TableId { get; set; }
    [Parameter] public string TableName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSessionStarted { get; set; }

    private bool isVisible;
    private bool loading = true;
    private bool submitting;
    private string? errorMessage;
    private string? successMessage;

    private List<HourlyFeeDto> hourlyFees = new();
    private List<CustomerDto> customers = new();
    private decimal? selectedFee;

    private StartSessionModel model = new();

    private class StartSessionModel
    {
        public int SeatsCount { get; set; } = 1;
        public int AnonymousCustomersCount { get; set; } = 0;
        public List<int> CustomerIds { get; set; } = new();
    }

    public async Task Show()
    {
        model = new StartSessionModel { SeatsCount = 1, AnonymousCustomersCount = 0 };
        errorMessage = null;
        successMessage = null;
        isVisible = true;
        loading = true;

        await LoadData();
    }

    public void Close()
    {
        isVisible = false;
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;

            // Load hourly fees
            var feesResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/hourlyfees"));
            if (feesResponse.IsSuccessStatusCode)
            {
                hourlyFees = await feesResponse.Content.ReadFromJsonAsync<List<HourlyFeeDto>>() ?? new();
                hourlyFees = hourlyFees.OrderBy(f => f.SeatsCount).ToList();
                
                if (hourlyFees.Any())
                {
                    model.SeatsCount = hourlyFees.First().SeatsCount;
                    selectedFee = hourlyFees.First().Fee;
                }
            }

            // Load customers
            var customersResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/customers"));
            if (customersResponse.IsSuccessStatusCode)
            {
                customers = await customersResponse.Content.ReadFromJsonAsync<List<CustomerDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.LoadingError}: {ex.Message}";
            loading = false;
        }
    }

    private void IncrementAnonymousCount()
    {
        model.AnonymousCustomersCount++;
        OnCustomersOrCountChanged();
    }

    private void DecrementAnonymousCount()
    {
        if (model.AnonymousCustomersCount > 0)
        {
            model.AnonymousCustomersCount--;
            OnCustomersOrCountChanged();
        }
    }

    private void OnCustomersOrCountChanged()
    {
        // Calculate total seats count (registered customers + anonymous customers)
        var registeredCustomersCount = model.CustomerIds.Count;
        var totalCustomersCount = registeredCustomersCount + model.AnonymousCustomersCount;
        
        // If no customers at all, use the minimum seats count
        if (totalCustomersCount == 0)
        {
            if (hourlyFees.Any())
            {
                model.SeatsCount = hourlyFees.First().SeatsCount;
                selectedFee = hourlyFees.First().Fee;
            }
            return;
        }
        
        // Set seats count to total customers
        model.SeatsCount = totalCustomersCount;
        
        // Find the appropriate fee for the seats count
        // If exact match exists, use it; otherwise, find the next higher tier
        var exactFee = hourlyFees.FirstOrDefault(f => f.SeatsCount == model.SeatsCount);
        if (exactFee != null)
        {
            selectedFee = exactFee.Fee;
        }
        else
        {
            var nextHigherFee = hourlyFees
                .Where(f => f.SeatsCount > model.SeatsCount)
                .OrderBy(f => f.SeatsCount)
                .FirstOrDefault();
            
            if (nextHigherFee != null)
            {
                model.SeatsCount = nextHigherFee.SeatsCount;
                selectedFee = nextHigherFee.Fee;
            }
            else
            {
                // Use the highest available tier
                var highestFee = hourlyFees.OrderByDescending(f => f.SeatsCount).FirstOrDefault();
                if (highestFee != null)
                {
                    model.SeatsCount = highestFee.SeatsCount;
                    selectedFee = highestFee.Fee;
                }
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            submitting = true;
            errorMessage = null;
            successMessage = null;

            var command = new
            {
                tableId = TableId,
                seatsCount = model.SeatsCount,
                anonymousCustomersCount = model.AnonymousCustomersCount,
                customerIds = model.CustomerIds.Any() ? model.CustomerIds : null
            };

            var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/sessions/start"), command);

            if (response.IsSuccessStatusCode)
            {
                successMessage = PersianResources.SessionStartedSuccess;
                await Task.Delay(1000);
                await OnSessionStarted.InvokeAsync();
                Close();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"{PersianResources.ErrorStartingSession}: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.ErrorStartingSession}: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }

    // DTOs
    private class HourlyFeeDto
    {
        public int Id { get; set; }
        public int SeatsCount { get; set; }
        public decimal Fee { get; set; }
    }

    private class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
