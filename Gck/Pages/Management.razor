@page "/management"
@using Gck.Resources

<PageTitle>@PersianResources.ManagementDashboard</PageTitle>

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-tachometer-alt"></i>
                @PersianResources.ManagementDashboard
            </h2>
        </div>

        @if (loading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else
        {
            <!-- Tables Status Section -->
            <div class="gaming-card fade-in-up">
                <div class="card-header-section">
                    <h3><i class="fas fa-table"></i> @PersianResources.TablesStatus</h3>
                </div>

                @if (dashboardTables.Any())
                {
                    <div class="users-grid">
                        @foreach (var table in dashboardTables)
                        {
                            <div class="user-card fade-in-up">
                                <div class="user-header">
                                    <div class="user-avatar @(table.IsOccupied ? "occupied" : "available")">
                                        <i class="fas fa-table"></i>
                                    </div>
                                    <div class="user-info">
                                        <h3 class="user-name">@table.Name</h3>
                                        @if (table.CurrentSession != null)
                                        {
                                            <p class="user-username">
                                                <i class="fas fa-clock"></i> @GetSessionDuration(table.CurrentSession.StartDateTime)
                                                | <i class="fas fa-coins"></i> @table.CurrentSession.FeePerHour.ToString("N0") @PersianResources.TomanPerHour
                                            </p>
                                            @if (table.CurrentSession.Customers.Any())
                                            {
                                                <p class="user-detail">
                                                    <i class="fas fa-users"></i> @string.Join("، ", table.CurrentSession.Customers.Select(c => c.Name))
                                                </p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="user-username">@PersianResources.ReadyToStart</p>
                                        }
                                    </div>
                                    <div class="user-status @(table.IsOccupied ? "inactive" : "active")">
                                        @(table.IsOccupied ? PersianResources.TableOccupied : PersianResources.TableAvailable)
                                    </div>
                                </div>

                                @if (table.CurrentSession != null)
                                {
                                    <div class="session-details">
                                        <div class="live-timer-container">
                                            <div class="live-timer">
                                                <i class="fas fa-stopwatch"></i>
                                                <span class="timer-value">@GetSessionDuration(table.CurrentSession.StartDateTime)</span>
                                                <span class="timer-label">@PersianResources.ElapsedTime</span>
                                            </div>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label"><i class="fas fa-play-circle"></i> @PersianResources.Start:</span>
                                            <span class="detail-value">@table.CurrentSession.StartDateTime.ToPersianDateTime()</span>
                                        </div>
                                    </div>
                                }

                                <div class="user-actions">
                                    @if (table.CurrentSession != null)
                                    {
                                        <button class="btn-action btn-delete" @onclick="() => ShowFinishModal(table.CurrentSession.Id)">
                                            <i class="fas fa-stop"></i>
                                            @PersianResources.FinishSessionButton
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-action btn-edit" @onclick="() => ShowStartModal(table.Id, table.Name)">
                                            <i class="fas fa-play"></i>
                                            @PersianResources.StartSessionButton
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>@PersianResources.NoTablesFound</p>
                    </div>
                }
            </div>

            <!-- Analytics Charts Section -->
            <div class="gaming-card fade-in-up" style="margin-top: 2rem;">
                <div class="card-header-section">
                    <h3><i class="fas fa-chart-line"></i> @PersianResources.AnalyticsCharts</h3>
                </div>
                <div class="charts-container">
                    <div class="chart-placeholder">
                        <i class="fas fa-chart-bar"></i>
                        <p>@PersianResources.DailyComparison</p>
                        <small>@PersianResources.InDevelopment</small>
                    </div>
                    <div class="chart-placeholder">
                        <i class="fas fa-chart-pie"></i>
                        <p>@PersianResources.MonthlyComparison</p>
                        <small>@PersianResources.InDevelopment</small>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<StartSessionModal @ref="startSessionModal" 
                   TableId="@selectedTableId" 
                   TableName="@selectedTableName"
                   OnSessionStarted="@HandleSessionChanged" />

<FinishSessionModal @ref="finishSessionModal"
                    OnSessionFinished="@HandleSessionChanged" />
