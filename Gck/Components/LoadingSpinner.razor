@* Loading Spinner Component - Gaming Theme *@

<div class="loading-container @GetContainerClasses()" style="@ContainerStyle">
    <div class="gaming-loader">
        <div class="loader-ring"></div>
        <div class="loader-ring"></div>
        <div class="loader-ring"></div>
        @if (!string.IsNullOrWhiteSpace(LoadingText))
        {
            <div class="loading-text">@LoadingText</div>
        }
    </div>
</div>
