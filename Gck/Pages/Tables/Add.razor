@page "/tables/add"
@using Gck.Application.Features.Tables.Commands.CreateTable
@using Gck.Resources
@using Gck.Services
@using Gck.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ApiConfigurationService ApiConfig
@inject INotificationService NotificationService

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-plus-circle"></i>
                @PersianResources.AddNewTable
            </h2>
            <button class="btn-gaming btn-secondary" @onclick="NavigateBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        <div class="gaming-card fade-in-up">
            <EditForm Model="@command" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-tag"></i>
                        @PersianResources.TableName <span class="required">@PersianResources.Required</span>
                    </label>
                    <InputText @bind-Value="command.Name" class="form-input" placeholder="@PersianResources.TableNamePlaceholder" />
                    <ValidationMessage For="@(() => command.Name)" class="validation-error" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-gaming" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>@PersianResources.Submitting</span>
                        }
                        else
                        {
                            <i class="fas fa-save"></i>
                            <span>@PersianResources.SubmitTable</span>
                        }
                    </button>
                    <button type="button" class="btn-gaming btn-secondary" @onclick="NavigateBack" disabled="@isSubmitting">
                        <i class="fas fa-times"></i>
                        @PersianResources.Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private CreateTableCommand command = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/tables"), command);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.ShowSuccess(PersianResources.TableAddSuccess);
            await Task.Delay(1500);
            Navigation.NavigateTo("/tables");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            NotificationService.ShowError($"{PersianResources.Error}: {error}");
        }

        isSubmitting = false;
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/tables");
    }
}
