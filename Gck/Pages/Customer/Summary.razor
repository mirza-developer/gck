@page "/customer/summary"
@using Gck.Resources
@using Gck.Components

<section class="section">
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-user-circle"></i>
                @PersianResources.MySummary
            </h1>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @errorMessage
            </div>
        }
        else if (customer != null)
        {
            <div class="gaming-card fade-in-up">
                <!-- Customer Info Section -->
                <div class="grid-details-content" style="margin-bottom: 2rem;">
                    <div class="grid-details-header">
                        <i class="fas fa-user"></i>
                        <h4>@PersianResources.CustomerFullDetails</h4>
                    </div>
                    <div class="grid-details-body">
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-user"></i>
                                @PersianResources.CustomerName
                            </div>
                            <div class="grid-detail-value">
                                @customer.Name
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-phone"></i>
                                @PersianResources.Phone
                            </div>
                            <div class="grid-detail-value">
                                @customer.PhoneNumber
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas fa-calendar-alt"></i>
                                @PersianResources.BirthYear
                            </div>
                            <div class="grid-detail-value">
                                @customer.BirthYear @PersianResources.Shamsi
                            </div>
                        </div>
                        <div class="grid-detail-item">
                            <div class="grid-detail-label">
                                <i class="fas @(customer.IsMale ? "fa-mars" : "fa-venus")"></i>
                                @PersianResources.Gender
                            </div>
                            <div class="grid-detail-value">
                                @(customer.IsMale ? PersianResources.Male : PersianResources.Female)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loyalty Info Section -->
                @if (customer.IsLoyal)
                {
                    <div class="grid-details-content" style="margin-bottom: 2rem;">
                        <div class="grid-details-header">
                            <i class="fas fa-star"></i>
                            <h4>@PersianResources.LoyaltyInfo</h4>
                        </div>
                        <div class="grid-details-body">
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-coins"></i>
                                    @PersianResources.TotalPaidSessions
                                </div>
                                <div class="grid-detail-value highlight">
                                    @customer.PaidSessionsCount @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-gift"></i>
                                    @PersianResources.SessionsRequiredForFree
                                </div>
                                <div class="grid-detail-value">
                                    @customer.SessionsRequiredForFree @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-trophy"></i>
                                    @PersianResources.FreeSessionsEarned
                                </div>
                                <div class="grid-detail-value highlight">
                                    @(customer.PaidSessionsCount / customer.SessionsRequiredForFree) @PersianResources.Times
                                </div>
                            </div>
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-hourglass-half"></i>
                                    @PersianResources.SessionsUntilFree
                                </div>
                                <div class="grid-detail-value highlight">
                                    @(customer.SessionsRequiredForFree - (customer.PaidSessionsCount % customer.SessionsRequiredForFree)) @PersianResources.Times
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Credit Balance Section -->
                @if (customer.ReferralCredit > 0)
                {
                    <div class="grid-details-content" style="margin-bottom: 2rem;">
                        <div class="grid-details-header">
                            <i class="fas fa-coins"></i>
                            <h4>@PersianResources.ReferralCredit</h4>
                        </div>
                        <div class="grid-details-body">
                            <div class="grid-detail-item">
                                <div class="grid-detail-label">
                                    <i class="fas fa-wallet"></i>
                                    @PersianResources.CreditBalance
                                </div>
                                <div class="grid-detail-value highlight" style="font-size: 1.5rem; color: #00cc66;">
                                    @customer.ReferralCredit.ToString("N0") @PersianResources.Toman
                                </div>
                            </div>
                        </div>
                        <div style="padding: 0 1rem 1rem;">
                            <a href="/customer/credits" class="btn-gaming" style="display: inline-block; text-decoration: none; font-size: 0.9rem; padding: 0.5rem 1rem;">
                                <i class="fas fa-money-bill-wave"></i>
                                @PersianResources.RequestCashWithdrawal
                            </a>
                        </div>
                    </div>
                }

                <!-- Sessions List -->
                <div class="grid-details-header">
                    <i class="fas fa-gamepad"></i>
                    <h4>@PersianResources.MySessions</h4>
                </div>
                @if (sessions != null && sessions.Any())
                {
                    <div class="data-grid">
                        <table class="data-grid-table">
                            <thead class="data-grid-header">
                                <tr>
                                    <th>@PersianResources.SessionDate</th>
                                    <th>@PersianResources.TableUsed</th>
                                    <th>@PersianResources.Duration</th>
                                    <th>@PersianResources.AmountPaid</th>
                                </tr>
                            </thead>
                            <tbody class="data-grid-body">
                                @foreach (var session in sessions)
                                {
                                    <tr>
                                        <td>
                                            <span class="grid-cell-primary">@session.StartDateTime.ToString("yyyy/MM/dd HH:mm")</span>
                                        </td>
                                        <td>
                                            <span class="grid-cell-secondary">@session.TableName</span>
                                        </td>
                                        <td>
                                            <span class="grid-cell-secondary">@GetDuration(session)</span>
                                        </td>
                                        <td>
                                            @if (session.IsFreeSession)
                                            {
                                                <span class="grid-cell-badge" style="background: rgba(0, 255, 0, 0.2); color: #00ff00; border: 1px solid rgba(0, 255, 0, 0.3);">
                                                    <i class="fas fa-gift"></i>
                                                    @PersianResources.Free
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="grid-cell-primary">@session.FinalPrice?.ToString("N0") @PersianResources.Toman</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>@PersianResources.NoSessionsYet</p>
                    </div>
                }
            </div>
        }
    </div>
</section>
