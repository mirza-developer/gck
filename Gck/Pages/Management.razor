@page "/management"
@inject HttpClient Http
@inject ApiConfigurationService ApiConfig
@using System.Net.Http.Json
@using Gck.Components

<PageTitle>داشبورد مدیریت</PageTitle>

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-tachometer-alt"></i>
                داشبورد مدیریت گیم سنتر کوثر
            </h2>
        </div>

        @if (loading)
        {
            <div class="loading-container">
                <div class="gaming-loader">
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <div class="loader-ring"></div>
                    <p class="loader-text">در حال بارگذاری...</p>
                </div>
            </div>
        }
        else if (error != null)
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                <p><strong>خطا:</strong> @error</p>
                <hr />
                <p><small>برای استفاده از داشبورد، ابتدا باید سرور API را اجرا کنید.</small></p>
                <code style="display: block; background: #f5f5f5; padding: 10px; border-radius: 5px; direction: ltr; margin-top: 1rem;">
                    cd Gck.Api && dotnet run
                </code>
            </div>
        }
        else
        {
            <!-- Tables Status Section -->
            <div class="gaming-card fade-in-up">
                <div class="card-header-section">
                    <h3><i class="fas fa-table"></i> وضعیت میزها</h3>
                </div>

                @if (dashboardTables.Any())
                {
                    <div class="users-grid">
                        @foreach (var table in dashboardTables)
                        {
                            <div class="user-card fade-in-up">
                                <div class="user-header">
                                    <div class="user-avatar @(table.IsOccupied ? "occupied" : "available")">
                                        <i class="fas fa-table"></i>
                                    </div>
                                    <div class="user-info">
                                        <h3 class="user-name">@table.Name</h3>
                                        @if (table.CurrentSession != null)
                                        {
                                            <p class="user-username">
                                                <i class="fas fa-clock"></i> @GetSessionDuration(table.CurrentSession.StartDateTime)
                                                | <i class="fas fa-coins"></i> @table.CurrentSession.FeePerHour.ToString("N0") تومان/ساعت
                                            </p>
                                            @if (table.CurrentSession.Customers.Any())
                                            {
                                                <p class="user-detail">
                                                    <i class="fas fa-users"></i> @string.Join("، ", table.CurrentSession.Customers.Select(c => c.Name))
                                                </p>
                                            }
                                        }
                                        else
                                        {
                                            <p class="user-username">آماده برای شروع جلسه</p>
                                        }
                                    </div>
                                    <div class="user-status @(table.IsOccupied ? "inactive" : "active")">
                                        @(table.IsOccupied ? "اشغال" : "آزاد")
                                    </div>
                                </div>

                                @if (table.CurrentSession != null)
                                {
                                    <div class="session-details">
                                        <div class="detail-row">
                                            <span class="detail-label"><i class="fas fa-play-circle"></i> شروع:</span>
                                            <span class="detail-value">@table.CurrentSession.StartDateTime.ToString("HH:mm - yyyy/MM/dd")</span>
                                        </div>
                                    </div>
                                }

                                <div class="user-actions">
                                    @if (table.CurrentSession != null)
                                    {
                                        <button class="btn-action btn-delete" @onclick="() => ShowFinishModal(table.CurrentSession.Id)">
                                            <i class="fas fa-stop"></i>
                                            پایان جلسه
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-action btn-edit" @onclick="() => ShowStartModal(table.Id, table.Name)">
                                            <i class="fas fa-play"></i>
                                            شروع جلسه
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>هیچ میزی یافت نشد</p>
                    </div>
                }
            </div>

            <!-- Analytics Charts Section -->
            <div class="gaming-card fade-in-up" style="margin-top: 2rem;">
                <div class="card-header-section">
                    <h3><i class="fas fa-chart-line"></i> آمار و تحلیل‌ها</h3>
                </div>
                <div class="charts-container">
                    <div class="chart-placeholder">
                        <i class="fas fa-chart-bar"></i>
                        <p>نمودار مقایسه روزانه</p>
                        <small>در حال توسعه</small>
                    </div>
                    <div class="chart-placeholder">
                        <i class="fas fa-chart-pie"></i>
                        <p>نمودار مقایسه ماهانه</p>
                        <small>در حال توسعه</small>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<StartSessionModal @ref="startSessionModal" 
                   TableId="@selectedTableId" 
                   TableName="@selectedTableName"
                   OnSessionStarted="@HandleSessionChanged" />

<FinishSessionModal @ref="finishSessionModal"
                    OnSessionFinished="@HandleSessionChanged" />

@code {
    private List<DashboardTableDto> dashboardTables = new();
    private bool loading = true;
    private string? error = null;

    private StartSessionModal? startSessionModal;
    private FinishSessionModal? finishSessionModal;
    private int selectedTableId;
    private string selectedTableName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            error = null;

            var response = await Http.GetAsync(ApiConfig.GetApiUrl("/api/dashboard/tables"));
            if (response.IsSuccessStatusCode)
            {
                dashboardTables = await response.Content.ReadFromJsonAsync<List<DashboardTableDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            loading = false;
        }
    }

    private async Task ShowStartModal(int tableId, string tableName)
    {
        selectedTableId = tableId;
        selectedTableName = tableName;

        if (startSessionModal != null)
        {
            await startSessionModal.Show();
            StateHasChanged();
        }
    }

    private async Task ShowFinishModal(int sessionId)
    {
        if (finishSessionModal != null)
        {
            await finishSessionModal.Show(sessionId);
        }
    }

    private async Task HandleSessionChanged()
    {
        await LoadData();
    }

    private string GetSessionDuration(DateTime startTime)
    {
        var duration = DateTime.Now - startTime;
        var hours = (int)duration.TotalHours;
        var minutes = duration.Minutes;
        
        if (hours > 0)
            return $"{hours}:{minutes:D2} ساعت";
        else
            return $"{minutes} دقیقه";
    }

    // DTOs
    public class DashboardTableDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool IsOccupied { get; set; }
        public SessionDto? CurrentSession { get; set; }
    }

    public class SessionDto
    {
        public int Id { get; set; }
        public int TableId { get; set; }
        public string TableName { get; set; } = string.Empty;
        public decimal FeePerHour { get; set; }
        public DateTime StartDateTime { get; set; }
        public DateTime? EndDateTime { get; set; }
        public bool IsCompleted { get; set; }
        public decimal? RecommendedPrice { get; set; }
        public decimal? FinalPrice { get; set; }
        public List<CustomerDto> Customers { get; set; } = new();
    }

    public class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public int BirthYear { get; set; }
        public string Gender { get; set; } = string.Empty;
    }
}
