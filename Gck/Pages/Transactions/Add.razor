@page "/transactions/add"
@using Gck.Application.DTOs
@using Gck.Resources
@using System.Net.Http.Json
@using Gck.Components
@using Gck.Services
@using Gck.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ApiConfigurationService ApiConfig
@inject INotificationService NotificationService

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-plus-circle"></i>
                @PersianResources.AddNewTransaction
            </h2>
            <button class="btn-secondary" @onclick="GoBack">
                <i class="fas fa-arrow-right"></i>
                @PersianResources.Back
            </button>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="gaming-card fade-in-up error-message">
                <i class="fas fa-exclamation-triangle"></i>
                @errorMessage
            </div>
        }
        else
        {
            <div class="gaming-card form-card fade-in-up">
                <form @onsubmit="HandleSubmit">
                    <div class="form-group">
                        <label for="accountId" class="form-label">
                            <i class="fas fa-university"></i>
                            @PersianResources.FinancialAccount
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputSelect @bind-Value="transaction.FinancialAccountId" class="form-input" id="accountId">
                            <option value="0">@PersianResources.SelectFinancialAccount</option>
                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">
                                    @account.AccountName (@account.BankName)
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label for="type" class="form-label">
                            <i class="fas fa-exchange-alt"></i>
                            @PersianResources.TransactionType
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputSelect @bind-Value="transaction.Type" class="form-input" id="type">
                            <option value="">@PersianResources.SelectTransactionType</option>
                            <option value="Income">@PersianResources.Income</option>
                            <option value="Outcome">@PersianResources.Outcome</option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label for="amount" class="form-label">
                            <i class="fas fa-money-bill-wave"></i>
                            @PersianResources.Amount (@PersianResources.Toman)
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <InputNumber @bind-Value="transaction.Amount" class="form-input" id="amount" placeholder="@PersianResources.AmountPlaceholder" />
                    </div>

                    <div class="form-group">
                        <label for="date" class="form-label">
                            <i class="fas fa-calendar-alt"></i>
                            @PersianResources.TransactionDate
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <PersianDatePicker @bind-Value="transaction.TransactionDate" />
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">
                            <i class="fas fa-align-left"></i>
                            @PersianResources.Description
                            <span class="required">@PersianResources.Required</span>
                        </label>
                        <textarea id="description" 
                                  @bind="transaction.Description" 
                                  class="form-input"
                                  placeholder="@PersianResources.DescriptionPlaceholder"
                                  rows="4"
                                  maxlength="500"
                                  required></textarea>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-gaming" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>@PersianResources.Saving</span>
                            }
                            else
                            {
                                <i class="fas fa-save"></i>
                                <span>@PersianResources.SubmitTransaction</span>
                            }
                        </button>
                        <button type="button" class="btn-secondary" @onclick="GoBack">
                            <i class="fas fa-times"></i>
                            @PersianResources.Cancel
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</section>

@code {
private CreateTransactionDto transaction = new();
private List<FinancialAccountDto> accounts = new();
private bool isLoading = true;
private bool isSaving = false;
private string errorMessage = string.Empty;
private readonly System.Globalization.PersianCalendar _persianCalendar = new();

private string GetCurrentPersianDate()
{
    var now = DateTime.Now;
    var year = _persianCalendar.GetYear(now);
    var month = _persianCalendar.GetMonth(now);
    var day = _persianCalendar.GetDayOfMonth(now);
    return $"{year:0000}/{month:00}/{day:00}";
}

protected override async Task OnInitializedAsync()
{
    transaction.TransactionDate = GetCurrentPersianDate();
    await LoadFinancialAccounts();
}

    private async Task LoadFinancialAccounts()
    {
        isLoading = true;
        errorMessage = string.Empty;

        accounts = await Http.GetFromJsonAsync<List<FinancialAccountDto>>(ApiConfig.GetApiUrl("/api/financialaccounts")) ?? new();

        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        if (transaction.FinancialAccountId == 0)
        {
            NotificationService.ShowWarning(PersianResources.PleaseSelectFinancialAccount);
            return;
        }

        if (string.IsNullOrEmpty(transaction.Type))
        {
            NotificationService.ShowWarning(PersianResources.PleaseSelectTransactionType);
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/transactions"), transaction);

        if (response.IsSuccessStatusCode)
        {
            NotificationService.ShowSuccess(PersianResources.TransactionAddSuccess);
            await Task.Delay(1500);
            Navigation.NavigateTo("/transactions");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = $"{PersianResources.ErrorSavingTransaction}: {error}";
        }

        isSaving = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/transactions");
    }
}
