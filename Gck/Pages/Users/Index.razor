@page "/users"
@using Gck.Components
@using Gck.Resources

<section class="section">
    <div class="container">
        <div class="page-header fade-in-up">
            <h2 class="section-title">
                <i class="fas fa-users"></i>
                مدیریت کاربران
            </h2>
            <button class="btn-gaming" @onclick="NavigateToAdd">
                <i class="fas fa-plus"></i>
                افزودن کاربر جدید
            </button>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner LoadingText="@PersianResources.Loading" />
        }
        else
        {
            <div class="gaming-card fade-in-up">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" 
                           placeholder="جستجوی کاربر (نام، نام کاربری)..." 
                           @bind="searchText" 
                           @bind:event="oninput"
                           class="search-input" />
                </div>

                @if (FilteredUsers.Any())
                {
                    <div class="users-grid">
                        @foreach (var user in FilteredUsers)
                        {
                            <div class="user-card fade-in-up">
                                <div class="user-header">
                                    <div class="user-avatar">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div class="user-info">
                                        <h3 class="user-name">@user.Name</h3>
                                        <p class="user-username">@@@user.Username</p>
                                    </div>
                                    <div class="user-status @(user.IsActive ? "active" : "inactive")">
                                        @(user.IsActive ? "فعال" : "غیرفعال")
                                    </div>
                                </div>
                                <div class="user-actions">
                                    <button class="btn-action btn-edit" @onclick="() => NavigateToEdit(user.Username)">
                                        <i class="fas fa-edit"></i>
                                        ویرایش
                                    </button>
                                    <button class="btn-action btn-delete" @onclick="() => DeleteUser(user.Id)">
                                        <i class="fas fa-trash"></i>
                                        حذف
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data">
                        <i class="fas fa-inbox"></i>
                        <p>کاربری یافت نشد</p>
                    </div>
                }
            </div>
        }
    </div>
</section>
