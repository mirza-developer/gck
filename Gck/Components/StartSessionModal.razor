@inject HttpClient Http
@inject ApiConfigurationService ApiConfig
@using System.Net.Http.Json
@using Gck.Shared.Modals
@using Gck.Resources

<Modal @bind-IsVisible="isVisible"
       Title="@PersianResources.StartSession"
       ShowFooter="false"
       CloseOnOverlayClick="@(!submitting)"
       Size="ModalSize.Medium">
    @if (loading)
    {
        <div class="text-center">
            <i class="fas fa-spinner fa-spin" style="font-size: 2rem;"></i>
            <p>@PersianResources.Loading</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">
            <i class="fas fa-exclamation-triangle"></i>
            @errorMessage
        </div>
    }
    else
    {
        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-table"></i>
                    @PersianResources.Table
                </label>
                <input type="text" class="form-input" value="@TableName" disabled />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-gamepad"></i>
                    @PersianResources.SeatsCount
                </label>
                <select class="form-input" @bind="model.SeatsCount" @bind:after="OnSeatsCountChanged">
                    @foreach (var fee in hourlyFees)
                    {
                        <option value="@fee.SeatsCount">@fee.SeatsCount @PersianResources.PersonSuffix - @fee.Fee.ToString("N0") @PersianResources.TomanPerHour</option>
                    }
                </select>
            </div>

            @if (model.SeatsCount > 0)
            {
                <div class="fee-display">
                    <i class="fas fa-coins"></i>
                    <span>@PersianResources.HourlyRate: <strong>@selectedFee?.ToString("N0") @PersianResources.Toman</strong></span>
                </div>
            }

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-users"></i>
                    @PersianResources.CustomersOptional
                </label>
                @if (customers.Any())
                {
                    <div class="customer-selection">
                        @foreach (var customer in customers)
                        {
                            <label class="customer-checkbox">
                                <input type="checkbox" 
                                       checked="@model.CustomerIds.Contains(customer.Id)"
                                       @onchange="@(e => OnCustomerToggle(customer.Id, (bool)e.Value!))" />
                                <span>@customer.Name (@customer.PhoneNumber)</span>
                            </label>
                        }
                    </div>
                }
                else
                {
                    <p class="text-secondary">@PersianResources.NoCustomersRegistered</p>
                }
            </div>

            @if (successMessage != null)
            {
                <div class="success-message">
                    <i class="fas fa-check-circle"></i>
                    @successMessage
                </div>
            }

            <div class="modal-actions">
                <button type="submit" class="btn-gaming" disabled="@submitting">
                    @if (submitting)
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                        <span>@PersianResources.Submitting</span>
                    }
                    else
                    {
                        <i class="fas fa-play"></i>
                        <span>@PersianResources.StartSession</span>
                    }
                </button>
                <button type="button" class="btn-gaming btn-secondary" @onclick="Close" disabled="@submitting">
                    <i class="fas fa-times"></i>
                    <span>@PersianResources.Cancel</span>
                </button>
            </div>
        </EditForm>
    }
</Modal>

@code {
    [Parameter] public int TableId { get; set; }
    [Parameter] public string TableName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSessionStarted { get; set; }

    private bool isVisible;
    private bool loading = true;
    private bool submitting;
    private string? errorMessage;
    private string? successMessage;

    private List<HourlyFeeDto> hourlyFees = new();
    private List<CustomerDto> customers = new();
    private decimal? selectedFee;

    private StartSessionModel model = new();

    private class StartSessionModel
    {
        public int SeatsCount { get; set; } = 1;
        public List<int> CustomerIds { get; set; } = new();
    }

    public async Task Show()
    {
        model = new StartSessionModel { SeatsCount = 1 };
        errorMessage = null;
        successMessage = null;
        isVisible = true;
        loading = true;

        await LoadData();
    }

    public void Close()
    {
        isVisible = false;
    }

    private async Task LoadData()
    {
        try
        {
            loading = true;
            errorMessage = null;

            // Load hourly fees
            var feesResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/hourlyfees"));
            if (feesResponse.IsSuccessStatusCode)
            {
                hourlyFees = await feesResponse.Content.ReadFromJsonAsync<List<HourlyFeeDto>>() ?? new();
                hourlyFees = hourlyFees.OrderBy(f => f.SeatsCount).ToList();
                
                if (hourlyFees.Any())
                {
                    model.SeatsCount = hourlyFees.First().SeatsCount;
                    selectedFee = hourlyFees.First().Fee;
                }
            }

            // Load customers
            var customersResponse = await Http.GetAsync(ApiConfig.GetApiUrl("/api/customers"));
            if (customersResponse.IsSuccessStatusCode)
            {
                customers = await customersResponse.Content.ReadFromJsonAsync<List<CustomerDto>>() ?? new();
            }

            loading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.LoadingError}: {ex.Message}";
            loading = false;
        }
    }

    private void OnSeatsCountChanged()
    {
        var fee = hourlyFees.FirstOrDefault(f => f.SeatsCount == model.SeatsCount);
        selectedFee = fee?.Fee;
    }

    private void OnCustomerToggle(int customerId, bool isChecked)
    {
        if (isChecked)
        {
            if (!model.CustomerIds.Contains(customerId))
            {
                model.CustomerIds.Add(customerId);
            }
        }
        else
        {
            model.CustomerIds.Remove(customerId);
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            submitting = true;
            errorMessage = null;
            successMessage = null;

            var command = new
            {
                tableId = TableId,
                seatsCount = model.SeatsCount,
                customerIds = model.CustomerIds.Any() ? model.CustomerIds : null
            };

            var response = await Http.PostAsJsonAsync(ApiConfig.GetApiUrl("/api/sessions/start"), command);

            if (response.IsSuccessStatusCode)
            {
                successMessage = PersianResources.SessionStartedSuccess;
                await Task.Delay(1000);
                await OnSessionStarted.InvokeAsync();
                Close();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"{PersianResources.ErrorStartingSession}: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{PersianResources.ErrorStartingSession}: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }

    // DTOs
    private class HourlyFeeDto
    {
        public int Id { get; set; }
        public int SeatsCount { get; set; }
        public decimal Fee { get; set; }
    }

    private class CustomerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
    }
}
