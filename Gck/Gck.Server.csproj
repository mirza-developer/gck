<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    This project file builds the Gck client as Blazor Server.
    All source files are shared with the WebAssembly project (Gck.csproj).
    Build command: dotnet build Gck/Gck.Server.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the same root namespace as Gck.csproj so all code-behind files match -->
    <RootNamespace>Gck</RootNamespace>
    <!-- Expose BLAZOR_SERVER constant so shared source code can use #if guards -->
    <DefineConstants>$(DefineConstants);BLAZOR_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorPro.BlazorSize" Version="8.0.0" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.1" />
  </ItemGroup>

  <!-- Exclude the WASM-only startup file -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gck.Application\Gck.Application.csproj" />
    <ProjectReference Include="..\Gck.Common\Gck.Common.csproj" />
  </ItemGroup>

</Project>
